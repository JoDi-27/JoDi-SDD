#!/usr/bin/env bash
# jsdd: helper for the spec-driven development kit. See specs/README.md.
# Plain bash 3.2 + awk, so it runs on a stock macOS or Linux laptop, or in Git
# Bash on Windows. Project files may have CRLF line endings (core.autocrlf), so
# the awk scripts that read them drop the CR first.
set -euo pipefail

# The plugin this script ships in, and the project it works on: $SDD_ROOT, else
# the git checkout of the current directory, else the current directory.
PLUGIN_DIR="$(cd "$(dirname "$0")/.." && pwd)"
TEMPLATES="$PLUGIN_DIR/templates"
STARTERS="$PLUGIN_DIR/starters"
ROOT="${SDD_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
SPECS_DIR="$ROOT/specs"
STATUSES="draft approved planned in-progress done blocked dropped"

# Claims: see "claims" below. Local mode keeps them in the git common dir, so
# every worktree of this clone shares them. Remote mode (git config
# jsdd.claims remote) keeps them as refs on a git remote, shared by every clone,
# and reads them through a cache in the git common dir. $SDD_CLAIMS overrides
# the config for one command (SDD_CLAIMS=local to work offline).
GIT_COMMON=""
if GIT_COMMON=$(cd "$ROOT" && git rev-parse --git-common-dir 2>/dev/null); then
  GIT_COMMON="$(cd "$ROOT" && cd "$GIT_COMMON" && pwd)"
  LOCAL_CLAIMS="$GIT_COMMON/sdd-claims"
else
  GIT_COMMON=""; LOCAL_CLAIMS="$SPECS_DIR/.claims"
fi
gitcfg() { [ -z "$GIT_COMMON" ] || git -C "$ROOT" config --get "$1" 2>/dev/null || true; }
CLAIMS_MODE="${SDD_CLAIMS:-$(gitcfg jsdd.claims)}"; CLAIMS_MODE="${CLAIMS_MODE:-local}"
CLAIMS_REMOTE="$(gitcfg jsdd.claimsRemote)"; CLAIMS_REMOTE="${CLAIMS_REMOTE:-origin}"
MAIN_BRANCH="${SDD_MAIN_BRANCH:-main}"
CLAIMS="$LOCAL_CLAIMS"
[ "$CLAIMS_MODE" != remote ] || [ -z "$GIT_COMMON" ] || CLAIMS="$GIT_COMMON/sdd-claims-remote"
ME="${CLAUDE_CODE_SESSION_ID:-${USER:-${USERNAME:-unknown}}@$(hostname -s 2>/dev/null || hostname)}"
STALE_HOURS="${SDD_STALE_HOURS:-8}"
FETCH_REUSE="${SDD_CLAIMS_REUSE:-30}"       # seconds a fetch of remote claims is reused by reads
REMOTE_TIMEOUT="${SDD_CLAIMS_TIMEOUT:-15}"  # seconds before a fetch or push is given up

usage() {
  cat <<EOF
Usage: jsdd <command>

  init [--migrate] [--dry-run]  Set up this project for the kit: copy the starters
                                where missing, refresh specs/README.md, and add the
                                .gitignore lines; --migrate also removes a kit that
                                install.sh copied into the project before the plugin.
                                Also flags starter paths the project already uses in
                                another format, lists documents elsewhere that may hold
                                a starter's content, and reports existing code and test commands

  new <feature|spike|baseline> <title>
                                Create specs/NNN-slug/spec.md from a template
  status [--write]              Print the progress board; --write also saves specs/STATUS.md
  next                          List what can be worked on now, and the command to run

  claim <ID>                    Claim a whole spec for this session (specify, plan, spike, verify)
  claim <ID> next               Claim the next task that can start now; prints its ID
  claim <ID> <Tn>               Claim one task, once the tasks it waits on are finished
  release <ID> [Tn] [--force]   Release a claim; --force for another session's
  done <ID> <Tn> [--manual <note>]
                                Run the task's check; only if it passes, tick the task
                                and mark its claim done. A manual check needs --manual
  done <ID> <AC-n> [--manual <note>]
                                The same for an acceptance criterion of a baseline spec,
                                in its spec.md; needs the claim on the whole spec
  claims [--prune]              List claims; --prune drops the ones no longer needed
  claims --mine                 Print the claims this session still holds (for the Stop hook)

  coverage [--phase N] [--priority M|S|C|W] [--missing] [ID or group ...]
                                Requirements in docs/requirements.md and the specs whose
                                refs cover them; --phase N scopes to the IDs and groups
                                PLAN.md's Phase N names; --missing lists only uncovered ones
  capabilities [--check] [ID or group ...]
                                Rows with an entry in docs/capabilities/, the spec that last
                                changed each, and live specs about to change them; lists done
                                specs whose Capability changes are not merged. --check exits 1
                                when there is a problem

  mode [--check | --explain]    The runtime mode and where it came from; --check
                                validates specs/jsdd.yml (exit 1 on any problem);
                                --explain lists every gate and its policy
  gate <gate>                   Print a gate's policy in the current mode: ask, auto, or park
  budget <name>                 Print a run budget in the current mode (attempts_per_task,
                                wall_time_hours, specs_per_run)

  park <ID> <gate> <reason>     Park a spec at a gate nobody can pass without a person: it
                                keeps its status, waits on the board, and next skips it
  unpark <ID>                   Put a parked spec back in the queue, once a person settled it
  run start|end|status <ID>     Mark a run (/jsdd:auto) on a spec for this session;
                                the Stop hook keeps the session going while it has work left
  run start|end|status --loop   Mark an autonomous loop (/jsdd:auto with no ID) for this session
  run next                      In a loop: start the run on the next spec in the queue, print its ID
  run active | stop-check       The specs this session runs; whether it may stop now
  charter [get <key>]           The autonomous charter's effective values (preset, product class,
                                scope, budgets, key gates), or one of them
  auto queue                    The specs an autonomous loop would take now, in order
  auto dry-run                  What a loop would take, where each spec may park, what it leaves out
  auto doctor                   Check what an unattended run needs: settings, git, gh, permission mode
  freeze <ID> [--accept <Tn>...]
                                Record each task's check in checks.lock; done then refuses a
                                task whose check changed. --accept needs a Deviation naming it
  pr <ID> [--title]             Print a pull request body (or title) from the spec, evidence,
                                deviations, and run report

Claims stop parallel sessions from picking the same work. They live in the git
common dir, so every worktree on this machine shares them, and are never committed.
The owner is \$CLAUDE_CODE_SESSION_ID, or user@host outside Claude Code.
Claims older than \$SDD_STALE_HOURS (default 8) are shown as stale.

To share claims with other people's clones: git config jsdd.claims remote. Each
claim is then a ref under refs/sdd-claims/ on the remote jsdd.claimsRemote (default
origin), taken with a push the remote accepts only once. A claim fails when the
remote is unreachable; reads fall back to the last fetch. SDD_CLAIMS=local works
offline for one command, with claims the others do not see.

The runtime mode is manual unless \$SDD_MODE picks another mode that specs/jsdd.yml
allows. Anything invalid falls back to manual, where every gate asks.
EOF
}

# --- helpers ---------------------------------------------------------------

slugify() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]' \
    | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//' | cut -c1-48 | sed -E 's/-+$//'
}

next_id() {
  local max=0 n d
  for d in "$SPECS_DIR"/[0-9][0-9][0-9]-*/; do
    [ -d "$d" ] || continue
    n=$(basename "$d" | cut -c1-3)
    n=$((10#$n))
    [ "$n" -gt "$max" ] && max=$n
  done
  # Specs already on the remote's main branch, which this branch may not have yet.
  for d in $( [ -z "$GIT_COMMON" ] || git -C "$ROOT" ls-tree --name-only "refs/remotes/$CLAIMS_REMOTE/$MAIN_BRANCH" -- specs/ 2>/dev/null || true); do
    d=$(basename "$d"); case $d in [0-9][0-9][0-9]-*) ;; *) continue ;; esac
    n=$(printf '%s' "$d" | cut -c1-3); n=$((10#$n))
    [ "$n" -gt "$max" ] && max=$n
  done
  # IDs reserved by other sessions, worktrees, or clones that are not visible here yet.
  for d in "$CLAIMS"/id-[0-9][0-9][0-9]/; do
    [ -d "$d" ] || continue
    n=$(basename "$d" | cut -c4-6)
    n=$((10#$n))
    [ "$n" -gt "$max" ] && max=$n
  done
  printf '%03d' $((max + 1))
}

norm_id() {
  case $1 in ""|*[!0-9]*) echo "invalid spec ID '$1'" >&2; exit 1 ;; esac
  printf '%03d' $((10#$1))
}

norm_task() {
  local t
  t=$(printf '%s' "$1" | tr -d 'Tt')
  case $t in ""|*[!0-9]*) echo "invalid task ID '$1'" >&2; exit 1 ;; esac
  printf 'T%d' $((10#$t))
}

norm_ac() {
  local a
  a=$(printf '%s' "$1" | tr -d 'ACac-')
  case $a in ""|*[!0-9]*) echo "invalid acceptance criterion '$1'" >&2; exit 1 ;; esac
  printf 'AC-%d' $((10#$a))
}

# spec_dir <ID>: the spec's folder.
spec_dir() {
  local d
  for d in "$SPECS_DIR/$1"-*/; do
    [ -d "$d" ] && { printf '%s' "${d%/}"; return; }
  done
  echo "no spec $1 in specs/" >&2
  return 1
}

# fm <file> <key>: value of a key in the YAML frontmatter (flat keys only).
# A double-quoted value has its \" and \\ escapes undone (see "new").
fm() {
  awk -v k="$2" '
    { sub(/\r$/, "") }
    NR == 1 { if ($0 != "---") exit; next }
    $0 == "---" { exit }
    {
      i = index($0, ":")
      if (i && substr($0, 1, i - 1) == k) {
        v = substr($0, i + 1)
        gsub(/^[ \t]+|[ \t]+$/, "", v)
        if (length(v) >= 2 && v ~ /^".*"$/) {
          v = substr(v, 2, length(v) - 2); out = ""
          for (j = 1; j <= length(v); j++) {
            c = substr(v, j, 1)
            if (c == "\\" && j < length(v)) { j++; c = substr(v, j, 1) }
            out = out c
          }
          v = out
        } else gsub(/^"|"$/, "", v)
        print v; exit
      }
    }' "$1"
}

# uncomment <files...>: the lines with HTML comments removed.
uncomment() {
  awk '
    { sub(/\r$/, ""); line = $0 }
    incomment { if (index(line, "-->")) { line = substr(line, index(line, "-->") + 3); incomment = 0 } else next }
    {
      while (index(line, "<!--")) {
        pre = substr(line, 1, index(line, "<!--") - 1); rest = substr(line, index(line, "<!--") + 4)
        if (index(rest, "-->")) line = pre substr(rest, index(rest, "-->") + 3)
        else { line = pre; incomment = 1 }
      }
      print line
    }' "$@"
}

# count <regex> <files...>: matching lines outside HTML comments.
count() {
  local re=$1; shift
  # The regex goes through the environment: awk -v would eat its backslashes.
  uncomment "$@" | RE="$re" awk '$0 ~ ENVIRON["RE"] { n++ } END { print n + 0 }'
}

# records: one tab-separated line per spec:
# id, type, status, phase, depends_on, done, total, open questions, title, dir,
# spec claim ("-" if none), task note ("-" if none), parked ("<gate>: <reason>", or "-")
records() {
  local d spec id type status phase deps title progress done total open num sclaim tnote parked
  for d in "$SPECS_DIR"/[0-9][0-9][0-9]-*/; do
    [ -d "$d" ] || continue
    d=${d%/}
    spec="$d/spec.md"
    [ -f "$spec" ] || { echo "warning: $(basename "$d") has no spec.md" >&2; continue; }
    id=$(fm "$spec" id); type=$(fm "$spec" type); status=$(fm "$spec" status)
    phase=$(fm "$spec" phase); deps=$(fm "$spec" depends_on); title=$(fm "$spec" title)
    case " $STATUSES " in *" $status "*) ;; *) echo "warning: $id has unknown status '$status'" >&2 ;; esac
    # Progress comes from tasks.md; a spike tracks the checkboxes in its spec.
    progress="$spec"; [ -f "$d/tasks.md" ] && progress="$d/tasks.md"
    done=$(count '^[[:space:]]*- \[[xX]\]' "$progress")
    total=$(count '^[[:space:]]*- \[[ xX]\]' "$progress")
    # shellcheck disable=SC2046  # the plan path is an optional extra argument, empty when there is no plan
    open=$(count '\[NEEDS CLARIFICATION' "$spec" $( [ -f "$d/plan.md" ] && echo "$d/plan.md" ))
    deps=$(printf '%s' "$deps" | tr -d "[] \"'")
    num=$(basename "$d" | cut -c1-3); sclaim=-; tnote=-
    [ -d "$CLAIMS/$num" ] && sclaim=$(claim_desc "$num")
    case $status in planned|in-progress) [ -f "$d/tasks.md" ] && tnote=$(task_note "$num" "$d/tasks.md") ;; esac
    # A verification the user declined blocks the spec until /jsdd:plan resumes it.
    if [ "$status" = blocked ] && [ -f "$d/verify-report.md" ] &&
      uncomment "$d/verify-report.md" | grep -q '^\*\*Decision:\*\* declined'; then tnote="verify declined"; fi
    # An approved spec change sends the spec back to draft for /jsdd:specify, then /jsdd:plan.
    if [ "$status" = draft ] && [ -f "$d/verify-report.md" ] &&
      uncomment "$d/verify-report.md" | grep -q '^\*\*Decision:\*\* approved'; then tnote="verify spec change"; fi
    parked=$(fm "$spec" parked | tr '\t' ' ')
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
      "$id" "${type:--}" "${status:--}" "${phase:--}" "${deps:--}" "$done" "$total" "$open" "$title" "$(basename "$d")" \
      "$sclaim" "${tnote:--}" "${parked:--}"
  done
}

# --- claims ----------------------------------------------------------------
# Parallel sessions claim work before starting it, so two never pick the same
# spec or task. A claim is a directory made with mkdir, which is atomic:
#   $CLAIMS/003/        the whole spec (specify, plan, spike, verify)
#   $CLAIMS/003-T4/     one task (implement); a "done" file marks it finished,
#                       for worktrees that do not see the tick in tasks.md yet
#   $CLAIMS/id-004/     a spec ID reserved by "new"
# Each claim holds an "owner" file with owner=, since= (epoch), at= (local
# time), and once a task is done, branch= (where its code is).
#
# In remote mode the same layout is a cache of refs on $CLAIMS_REMOTE:
# refs/sdd-claims/<name> points at an empty-tree commit whose message holds
# those keys plus user=, host=, state=active|done, and a nonce (so no two
# claims are ever the same commit). Every write is a push leased on the ref's
# current value, so the remote decides who wins: a claim succeeds only if the
# ref does not exist, a release or done only if the ref is still the one this
# session last saw. Reads fetch refs/sdd-claims/* into refs/sdd-claims-remote/
# and rebuild the cache, reusing a fetch younger than $FETCH_REUSE seconds.
# The storage functions below are the only code that writes $CLAIMS.

remote_mode() { [ "$CLAIMS_MODE" = remote ]; }
CLAIMS_STAMP="$GIT_COMMON/sdd-claims-remote.fetched"   # "<epoch> <HH:MM> ok|offline"

# claim_get <claim> <key>
claim_get() { sed -n "s/^$2=//p" "$CLAIMS/$1/owner" 2>/dev/null | head -1; }

# with_timeout <command...>: run it, killed after $REMOTE_TIMEOUT seconds (bash
# 3.2 has no timeout). The watcher's output goes to /dev/null so a leftover
# sleep never holds a pipe open.
with_timeout() {
  local pid w rc=0
  "$@" & pid=$!
  ( sleep "$REMOTE_TIMEOUT"; kill "$pid" 2>/dev/null ) >/dev/null 2>&1 &
  w=$!
  wait "$pid" 2>/dev/null || rc=$?
  kill "$w" 2>/dev/null || true; wait "$w" 2>/dev/null || true
  return $rc
}

# remote_git <args...>: git against the claims remote, never prompting, with a
# timeout. Its stderr is kept in $REMOTE_ERR for messages.
REMOTE_ERR=""
remote_git() {
  local f="$GIT_COMMON/sdd-claims-remote.err.$$" rc=0
  GIT_TERMINAL_PROMPT=0 with_timeout git -C "$ROOT" "$@" 2>"$f" || rc=$?
  REMOTE_ERR=$(cat "$f" 2>/dev/null || true); rm -f "$f"
  [ $rc -ne 143 ] || REMOTE_ERR="no answer within ${REMOTE_TIMEOUT}s (\$SDD_CLAIMS_TIMEOUT)"
  return $rc
}

# claims_rebuild: the cache, from refs/sdd-claims-remote/*.
claims_rebuild() {
  local tmp="$CLAIMS.tmp.$$" line name="" sha
  rm -rf "$tmp"; mkdir -p "$tmp"
  git -C "$ROOT" for-each-ref --format='@@claim %(refname:lstrip=2) %(objectname)%0a%(contents)' refs/sdd-claims-remote |
    while IFS= read -r line; do
      case $line in
        "@@claim "*)
          name=${line#@@claim }; sha=${name##* }; name=${name% *}
          case $name in ""|*[!A-Za-z0-9-]*) name=""; continue ;; esac   # not a claim name: ignore
          mkdir "$tmp/$name"; printf 'sha=%s\n' "$sha" > "$tmp/$name/owner" ;;
        *=*)
          [ -n "$name" ] || continue
          printf '%s\n' "$line" >> "$tmp/$name/owner"
          [ "$line" != state=done ] || : > "$tmp/$name/done" ;;
      esac
    done
  rm -rf "$CLAIMS"
  mv "$tmp" "$CLAIMS" 2>/dev/null || true
  # Another session rebuilt it in between: then mv put ours inside theirs.
  rm -rf "${CLAIMS:?}/$(basename "$tmp")" "$tmp"
}

# claims_sync [write]: in remote mode, fetch the claims (and the main branch,
# for new and prune) and rebuild the cache. A read reuses a recent fetch and
# falls back to the cache when the remote is unreachable; a write always
# fetches and stops when the remote is unreachable.
claims_sync() {
  remote_mode || return 0
  [ -n "$GIT_COMMON" ] || { echo "remote claims need a git repository" >&2; exit 1; }
  local now last=0 claims_spec
  now=$(date +%s)
  [ -f "$CLAIMS_STAMP" ] && last=$(awk '$3 == "ok" { print $1 }' "$CLAIMS_STAMP")
  if [ "${1:-}" != write ] && [ $((now - ${last:-0})) -lt "$FETCH_REUSE" ]; then return 0; fi
  if ! git -C "$ROOT" remote get-url "$CLAIMS_REMOTE" >/dev/null 2>&1; then
    echo "remote claims: no git remote '$CLAIMS_REMOTE' (set it with: git config jsdd.claimsRemote <name>)" >&2; exit 1
  fi
  claims_spec="+refs/sdd-claims/*:refs/sdd-claims-remote/*"
  # One round trip; without a main branch on the remote, fetch only the claims.
  if remote_git fetch -q --prune --no-tags "$CLAIMS_REMOTE" "$claims_spec" \
      "+refs/heads/$MAIN_BRANCH:refs/remotes/$CLAIMS_REMOTE/$MAIN_BRANCH" ||
    { case $REMOTE_ERR in *"couldn't find remote ref"*) remote_git fetch -q --prune --no-tags "$CLAIMS_REMOTE" "$claims_spec" ;; *) false ;; esac; }; then
    claims_rebuild
    printf '%s %s ok\n' "$now" "$(date '+%H:%M')" > "$CLAIMS_STAMP"
    return 0
  fi
  if [ "${1:-}" = write ]; then
    printf 'cannot reach the claims remote %s, so nothing was claimed or changed:\n%s\n' "$CLAIMS_REMOTE" "$REMOTE_ERR" >&2
    echo "To work offline, SDD_CLAIMS=local jsdd ... takes a claim on this machine only; other clones do not see it." >&2
    exit 1
  fi
  [ -f "$CLAIMS_STAMP" ] && sed 's/ ok$/ offline/' "$CLAIMS_STAMP" > "$CLAIMS_STAMP.$$" && mv "$CLAIMS_STAMP.$$" "$CLAIMS_STAMP"
  return 0
}

# claims_banner: where the claims come from, in remote mode.
claims_banner() {
  remote_mode || return 0
  local at state
  [ -f "$CLAIMS_STAMP" ] || { echo "  (remote $CLAIMS_REMOTE, never fetched)"; return 0; }
  read -r _ at state < "$CLAIMS_STAMP"
  if [ "$state" = ok ]; then echo "  (remote $CLAIMS_REMOTE, as of $at)"
  else echo "  (remote $CLAIMS_REMOTE unreachable; claims as of $at)"
  fi
}

# local_leftovers: in remote mode, claims still held in local mode, which no
# other clone sees.
local_leftovers() {
  remote_mode || return 0
  local c name out=""
  for c in "$LOCAL_CLAIMS"/[0-9]*/; do
    [ -d "$c" ] && [ ! -f "$c/done" ] || continue
    name=$(basename "$c"); out="$out ${name/-/ },"
  done
  [ -z "$out" ] || printf '  warning: claims held in local mode are not shared:%s release them with SDD_CLAIMS=local jsdd release <ID> [Tn]\n' "$out"
}

# claim_commit <name> <key=value...>: a new empty-tree commit holding the keys.
claim_commit() {
  local name=$1 body; shift
  body=$(printf 'jsdd claim %s\n\n' "$name"; printf '%s\n' "$@" "nonce=$$-$RANDOM-$(date +%s)")
  GIT_AUTHOR_NAME=jsdd GIT_AUTHOR_EMAIL=jsdd@invalid GIT_COMMITTER_NAME=jsdd GIT_COMMITTER_EMAIL=jsdd@invalid \
    git -C "$ROOT" commit-tree "$(git -C "$ROOT" hash-object -t tree /dev/null)" -m "$body"
}

# claim_store <name> <sha>: after a push, put the new commit in the cache.
claim_store() {
  git -C "$ROOT" update-ref "refs/sdd-claims-remote/$1" "$2"
  rm -rf "${CLAIMS:?}/$1"; mkdir -p "$CLAIMS/$1"
  { printf 'sha=%s\n' "$2"; git -C "$ROOT" log -1 --format=%b "$2" | grep '='; } > "$CLAIMS/$1/owner"
  if grep -qx state=done "$CLAIMS/$1/owner"; then : > "$CLAIMS/$1/done"; fi
}

# remote_push <name> <lease> <refspec>: one leased push of refs/sdd-claims/<name>.
remote_push() { remote_git push -q --no-verify "--force-with-lease=refs/sdd-claims/$1:$2" "$CLAIMS_REMOTE" "$3"; }

# who_am_i: user= and host= for a remote claim.
who_am_i() {
  local u
  u=$(gitcfg user.name); u=${u:-${USER:-${USERNAME:-unknown}}}
  printf 'user=%s\nhost=%s\n' "$(printf '%s' "$u" | tr -d '\r\n=')" "$(hostname -s 2>/dev/null || hostname)"
}

# claim_take <claim>: succeeds only if nobody holds it yet.
claim_take() {
  local sha since
  since=$(date +%s)
  if ! remote_mode; then
    mkdir -p "$CLAIMS"
    mkdir "$CLAIMS/$1" 2>/dev/null || return 1
    printf 'owner=%s\nsince=%s\nat=%s\n' "$ME" "$since" "$(date '+%Y-%m-%d %H:%M')" > "$CLAIMS/$1/owner"
    return 0
  fi
  [ ! -d "$CLAIMS/$1" ] || return 1
  sha=$(claim_commit "$1" "owner=$ME" "$(who_am_i)" "since=$since" "at=$(date '+%Y-%m-%d %H:%M')" state=active)
  if remote_push "$1" "" "$sha:refs/sdd-claims/$1"; then claim_store "$1" "$sha"; return 0; fi
  local err=$REMOTE_ERR
  claims_sync write
  [ -d "$CLAIMS/$1" ] && return 1   # another clone took it first
  printf 'remote claims: the push to %s failed:\n%s\n' "$CLAIMS_REMOTE" "$err" >&2; exit 1
}

# claim_mark_done <claim>: a finished task; records the branch its code is on.
claim_mark_done() {
  local branch sha old
  branch=$(git -C "$ROOT" rev-parse --abbrev-ref HEAD 2>/dev/null || true)
  if ! remote_mode; then
    [ -z "$branch" ] || printf 'branch=%s\n' "$branch" >> "$CLAIMS/$1/owner"
    : > "$CLAIMS/$1/done"; return 0
  fi
  old=$(claim_get "$1" sha)
  sha=$(claim_commit "$1" "$(grep -v -e '^sha=' -e '^state=' -e '^nonce=' -e '^branch=' "$CLAIMS/$1/owner")" \
    state=done "branch=$branch" "done_at=$(date '+%Y-%m-%d %H:%M')")
  if remote_push "$1" "$old" "$sha:refs/sdd-claims/$1"; then claim_store "$1" "$sha"; return 0; fi
  printf 'remote claims: could not mark %s done on %s (did another session release it?):\n%s\n' "${1/-/ }" "$CLAIMS_REMOTE" "$REMOTE_ERR" >&2
  echo "The tick is in tasks.md; run the same jsdd done again to retry marking the claim." >&2
  return 1
}

# claim_drop <claim>: delete it, if it is still the one this session last saw.
claim_drop() {
  if ! remote_mode; then rm -rf "${CLAIMS:?}/$1"; return 0; fi
  if remote_push "$1" "$(claim_get "$1" sha)" ":refs/sdd-claims/$1"; then
    git -C "$ROOT" update-ref -d "refs/sdd-claims-remote/$1" 2>/dev/null || true
    rm -rf "${CLAIMS:?}/$1"; return 0
  fi
  printf 'remote claims: could not release %s on %s (it changed since it was read; run again):\n%s\n' "${1/-/ }" "$CLAIMS_REMOTE" "$REMOTE_ERR" >&2
  return 1
}

mine() { [ "$(claim_get "$1" owner)" = "$ME" ]; }

stale() {
  local since
  since=$(claim_get "$1" since)
  [ -n "$since" ] && [ $(( $(date +%s) - since )) -gt $(( STALE_HOURS * 3600 )) ]
}

# claim_desc <claim>: "by <owner> since <time>", for messages.
claim_desc() {
  local o at
  local u h
  o=$(claim_get "$1" owner); at=$(claim_get "$1" at); u=$(claim_get "$1" user); h=$(claim_get "$1" host)
  if [ "$o" = "$ME" ]; then o=you
  elif [ -z "$o" ]; then o="another session"
  elif [ -n "$u" ] && [ "$o" = "$u@$h" ]; then o="$u@$h"
  elif [ -n "$u" ]; then o="$u@$h ($(printf '%s' "$o" | cut -c1-8))"
  else o=$(printf '%s' "$o" | cut -c1-8)
  fi
  printf 'by %s since %s' "$o" "${at:-just now}"
  if stale "$1"; then printf ' (stale)'; fi
  return 0
}

# task_rows <ID> <tasks.md>: one line per task: ID, ticked (0/1), [P] (0/1),
# claim (free, mine, other, done).
task_rows() {
  local id=$1 t ticked par state
  uncomment "$2" | awk '
    match($0, /^[[:space:]]*- \[[ xX]\] \*\*T[0-9]+\*\*/) {
      head = substr($0, RSTART, RLENGTH)
      t = head; sub(/^.*\*\*T/, "T", t); sub(/\*\*$/, "", t)
      print t, (head ~ /\[[xX]\]/ ? 1 : 0), (index(substr($0, RSTART + RLENGTH), "[P]") ? 1 : 0)
    }' | while read -r t ticked par; do
      state=free
      if [ -d "$CLAIMS/$id-$t" ]; then
        if [ -f "$CLAIMS/$id-$t/done" ]; then state=done
        elif mine "$id-$t"; then state=mine
        else state=other
        fi
      fi
      echo "$t $ticked $par $state"
    done
}

# task_gates <ID> <tasks.md>: task_rows plus a fifth field, the unfinished
# earlier tasks it waits on ("T3,T4"), or "-" if none. The one ordering rule:
# a task can start once every task before it is finished (ticked or claimed
# done), except the tasks in its own run of consecutive [P] tasks.
task_gates() {
  task_rows "$1" "$2" | awk '
    {
      fin = ($2 == 1 || $4 == "done")
      if ($3 == 1 && !prevpar) rungate = pending
      gate = ($3 == 1) ? rungate : pending
      print $0, (gate == "" ? "-" : gate)
      if (!fin) pending = pending (pending == "" ? "" : ",") $1
      prevpar = ($3 == 1)
    }'
}

# pick_task <ID> <tasks.md>: the first task that can start now, or nothing.
# (awk reads to the end: exiting early would kill the writer with SIGPIPE under pipefail.)
pick_task() { task_gates "$1" "$2" | awk '!found && $2 == 0 && $4 == "free" && $5 == "-" { print $1; found = 1 }'; }

# gate_list <gate>: "T3,T4" as "T3, T4", for messages.
gate_list() { printf '%s' "$1" | sed 's/,/, /g'; }

# task_note <ID> <tasks.md>: what "next" says about a spec's tasks.
task_note() {
  local free claimed
  free=$(pick_task "$1" "$2")
  claimed=$(task_rows "$1" "$2" | awk '$2 == 0 && ($4 == "mine" || $4 == "other") { printf "%s%s", sep, $1; sep = ", " }')
  if [ -n "$free" ] && [ -n "$claimed" ]; then echo "$free free; $claimed claimed"
  elif [ -n "$free" ]; then echo "$free free"
  elif [ -n "$claimed" ]; then echo "no task free; $claimed claimed"
  elif [ "$(task_rows "$1" "$2" | awk '$2 == 0 && $4 != "done"' | wc -l)" -eq 0 ]; then echo "all tasks done"
  else echo "no task free"
  fi
}

# others_tasks <ID>: unfinished task claims on a spec held by other sessions.
others_tasks() {
  local c name
  for c in "$CLAIMS/$1"-T*/; do
    [ -d "$c" ] || continue
    name=$(basename "$c")
    [ -f "$c/done" ] && continue
    mine "$name" && continue
    printf '  %s %s\n' "${name#*-}" "$(claim_desc "$name")"
  done
}

# note_unmerged <ID> <tasks.md> <Tn>: for the earlier tasks that are done but
# not ticked in this checkout, say which branch holds their code. Finished is
# not merged: building on them needs that branch first.
note_unmerged() {
  local cur u b who
  cur=$(git -C "$ROOT" rev-parse --abbrev-ref HEAD 2>/dev/null || true)
  task_rows "$1" "$2" | awk -v t="$3" '$1 == t { stop = 1 } !stop && $2 == 0 && $4 == "done" { print $1 }' |
    while read -r u; do
      b=$(claim_get "$1-$u" branch); who=$(claim_get "$1-$u" user)
      [ -n "$b" ] && [ "$b" != "$cur" ] || continue
      echo "note: $1 $u is done on branch $b${who:+ (by $who)}, not here yet; merge or rebase onto it before building on it" >&2
    done
}

claim_spec() {
  local id=$1 busy
  if [ -d "$CLAIMS/$id" ] && mine "$id"; then echo "$id already claimed by you"; return; fi
  busy=$(others_tasks "$id")
  if [ -n "$busy" ]; then
    printf '%s has tasks claimed by other sessions:\n%s\n' "$id" "$busy" >&2; exit 1
  fi
  if ! claim_take "$id"; then
    echo "$id is claimed $(claim_desc "$id")" >&2; exit 1
  fi
  echo "claimed $id"
}

claim_task() {
  local id=$1 f="$2/tasks.md" t row ticked state
  [ -f "$f" ] || { echo "$id has no tasks.md" >&2; exit 1; }
  if [ -d "$CLAIMS/$id" ] && ! mine "$id"; then
    echo "$id is claimed $(claim_desc "$id")" >&2; exit 1
  fi
  if [ "$3" = next ]; then
    # Resume a task this session already holds.
    t=$(task_rows "$id" "$f" | awk '!found && $2 == 0 && $4 == "mine" { print $1; found = 1 }')
    if [ -n "$t" ]; then echo "$t"; echo "($id $t is already claimed by you)" >&2; return; fi
    # If another session takes the pick first, mkdir fails and the next pick skips it.
    while t=$(pick_task "$id" "$f") && [ -n "$t" ]; do
      if claim_take "$id-$t"; then echo "$t"; note_unmerged "$id" "$f" "$t"; return; fi
    done
    if [ "$(task_note "$id" "$f")" = "all tasks done" ]; then
      echo "every task of $id is ticked or done; next: /jsdd:verify $id" >&2; exit 1
    fi
    echo "no task of $id can start now:" >&2
    task_gates "$id" "$f" | while read -r t ticked _ state gate; do
      [ "$ticked" = 1 ] && continue
      case $state in
        mine|other) echo "  $t claimed $(claim_desc "$id-$t")" >&2 ;;
        free) if [ "$gate" = - ]; then echo "  $t free" >&2; else echo "  $t waits on $(gate_list "$gate")" >&2; fi ;;
      esac
    done
    exit 1
  fi
  t=$(norm_task "$3")
  row=$(task_gates "$id" "$f" | awk -v t="$t" '$1 == t')
  [ -n "$row" ] || { echo "$id has no task $t" >&2; exit 1; }
  read -r _ ticked _ state gate <<EOF
$row
EOF
  [ "$ticked" = 1 ] && { echo "$id $t is already ticked" >&2; exit 1; }
  case $state in
    mine) echo "$t"; echo "($id $t is already claimed by you)" >&2; return ;;
    done) echo "$id $t is already done (claim marked done)" >&2; exit 1 ;;
    other) echo "$id $t is claimed $(claim_desc "$id-$t")" >&2; exit 1 ;;
  esac
  if [ "$gate" != - ]; then
    echo "$id $t waits on $(gate_list "$gate"); claim it with \`claim $id next\` once they are finished" >&2; exit 1
  fi
  claim_take "$id-$t" || { echo "$id $t is claimed $(claim_desc "$id-$t")" >&2; exit 1; }
  echo "$t"
  note_unmerged "$id" "$f" "$t"
}

# --- commands --------------------------------------------------------------

cmd_new() {
  [ $# -ge 2 ] || { usage >&2; exit 1; }
  local type=$1; shift
  local title="$*" tpl id slug dir today esc yesc
  case $type in
    feature) tpl=spec.md ;;
    spike) tpl=spike.md ;;
    baseline) tpl=baseline.md ;;
    *) echo "unknown type '$type' (use feature, spike, or baseline)" >&2; exit 1 ;;
  esac
  # Reserve the ID, so sessions in other worktrees do not take it too.
  id=$(next_id)
  until claim_take "id-$id"; do id=$(next_id); done
  slug=$(slugify "$title"); dir="$SPECS_DIR/$id-$slug"; today=$(date +%Y-%m-%d)
  # Escaped for the sed replacement; the frontmatter's quoted title also
  # escapes " and \ for YAML (fm undoes that). Headings keep the plain title.
  esc=$(printf '%s' "$title" | sed -e 's/[\\/&|]/\\&/g')
  yesc=$(printf '%s' "$title" | sed -e 's/[\\"]/\\&/g' -e 's/[\\/&|]/\\&/g')
  mkdir "$dir"
  sed -e "s|^title: \"{{TITLE}}\"|title: \"$yesc\"|" -e "s|{{ID}}|$id|g" -e "s|{{TITLE}}|$esc|g" -e "s|{{DATE}}|$today|g" \
    "$TEMPLATES/$tpl" > "$dir/spec.md"
  echo "${dir#"$ROOT"/}/spec.md"
}

board() {
  records | sort | awk -F '\t' '
    BEGIN {
      print "| ID | Type | Status | Phase | Progress | Open Qs | Depends on | Title |"
      print "| --- | --- | --- | --- | --- | --- | --- | --- |"
    }
    {
      prog = ($7 > 0) ? $6 "/" $7 : "-"
      if ($12 == "all tasks done") { prog = prog " ready to verify"; ready[$3]++ }
      t = $9; gsub(/\|/, "\\|", t)   # a | would end the table cell
      st = $3; if ($13 != "-") { st = st ", parked"; parked++ }
      printf "| %s | %s | %s | %s | %s | %s | %s | [%s](%s/) |\n", $1, $2, st, $4, prog, ($8 > 0 ? $8 : ""), ($5 == "-" ? "" : $5), t, $10
      n[$3]++; total++
    }
    END {
      if (!total) { print "| | | | | | | | No specs yet |" ; exit }
      printf "\n%d specs:", total
      split("draft approved planned in-progress done blocked dropped", order, " ")
      for (i = 1; i <= 7; i++) if (n[order[i]]) {
        printf " %s %d", order[i], n[order[i]]
        if (ready[order[i]]) printf " (%d ready to verify)", ready[order[i]]
        printf ","
      }
      if (parked) printf " %d parked,", parked
      print ""
    }' | sed -e '$ s/,$//'
}

# next: specs that are not finished and whose dependencies are all done.
next_up() {
  records | sort | awk -F '\t' '
    { id[NR] = $1; st[$1] = $3; deps[$1] = $5; title[$1] = $9; open[$1] = $8; type[$1] = $2; sclaim[$1] = $11; tnote[$1] = $12; parked[$1] = $13 }
    END {
      rank["in-progress"] = 1; rank["planned"] = 2; rank["approved"] = 3; rank["draft"] = 4
      for (r = 1; r <= 4; r++) for (i = 1; i <= NR; i++) {
        k = id[i]; if (rank[st[k]] != r) continue
        waiting = ""
        if (deps[k] != "-") { m = split(deps[k], d, ","); for (j = 1; j <= m; j++) if (st[d[j]] != "done") waiting = waiting " " d[j] }
        if (waiting != "") { blockedby[k] = waiting; continue }
        if (parked[k] != "-") continue
        if (sclaim[k] != "-") {
          hint = "claimed " sclaim[k]
          if (type[k] == "spike") hint = hint "; add notes to its Inbox"
        }
        else if (type[k] == "spike") hint = "/jsdd:spike " k
        else if (type[k] == "baseline") hint = (st[k] == "draft" ? "/jsdd:baseline " : "/jsdd:verify ") k
        else if (tnote[k] == "all tasks done") hint = "/jsdd:verify " k
        else if (tnote[k] ~ /^no task free/) hint = tnote[k]
        else if (st[k] == "in-progress" || st[k] == "planned") hint = "/jsdd:implement " k (tnote[k] != "-" ? "   (" tnote[k] ")" : "")
        else if (tnote[k] == "verify spec change") hint = "/jsdd:specify " k ", then /jsdd:plan " k "   (spec change from verify)"
        else if (open[k] > 0) hint = "/jsdd:specify " k "   (" open[k] " open questions)"
        else if (st[k] == "approved") hint = "/jsdd:plan " k
        else hint = "review spec, then /jsdd:plan " k
        printf "  %-4s %-11s %-60s %s\n", k, st[k], substr(title[k], 1, 60), hint; shown++
      }
      if (!shown) print "  (nothing actionable; create a spec with /jsdd:specify)"
      for (i = 1; i <= NR; i++) if (parked[id[i]] != "-" && st[id[i]] != "done" && st[id[i]] != "dropped") {
        if (!waitshown++) print "Waiting for you:"
        printf "  %-4s parked at %s; settle it, then: jsdd unpark %s\n", id[i], parked[id[i]], id[i]
      }
      for (i = 1; i <= NR; i++) {
        k = id[i]
        if (k in blockedby) printf "  %-4s waiting on%s\n", k, blockedby[k]
        else if (st[k] == "blocked" && tnote[k] == "verify declined") printf "  %-4s blocked: verification declined; resume with /jsdd:plan %s\n", k, k
        else if (st[k] == "blocked") printf "  %-4s blocked (see spec)\n", k
      }
    }'
}

cmd_claim() {
  [ $# -ge 1 ] || { usage >&2; exit 1; }
  local id dir
  id=$(norm_id "$1"); dir=$(spec_dir "$id")
  if [ $# -eq 1 ]; then claim_spec "$id"; else claim_task "$id" "$dir" "$2"; fi
}

cmd_release() {
  [ $# -ge 1 ] || { usage >&2; exit 1; }
  local id name a t="" force=0
  id=$(norm_id "$1"); shift
  for a in "$@"; do
    case $a in
      --force) force=1 ;;
      -*) echo "unknown option '$a' (task claims are marked done by: jsdd done <ID> <Tn>)" >&2; exit 1 ;;
      *) t=$(norm_task "$a") ;;
    esac
  done
  name=$id; [ -n "$t" ] && name="$id-$t"
  [ -d "$CLAIMS/$name" ] || { echo "no claim on $id $t"; return; }
  if [ $force = 0 ] && ! mine "$name"; then
    echo "$id $t is claimed $(claim_desc "$name"); use --force if that session is gone" >&2; exit 1
  fi
  claim_drop "$name" || exit 1
  echo "released $id $t"
}

# task_line <tasks.md> <Tn>: "<line number><TAB><line>" of the task, outside
# HTML comments, or nothing.
task_line() {
  awk -v t="$2" '
    { sub(/\r$/, "") }
    incomment { if (index($0, "-->")) incomment = 0; next }
    {
      line = $0
      while (index(line, "<!--")) {
        rest = substr(line, index(line, "<!--") + 4)
        if (index(rest, "-->")) line = substr(line, 1, index(line, "<!--") - 1) substr(rest, index(rest, "-->") + 3)
        else { line = substr(line, 1, index(line, "<!--") - 1); incomment = 1 }
      }
      if (line ~ ("^[[:space:]]*- \\[[ xX]\\] \\*\\*" t "\\*\\*")) { print NR "\t" $0; exit }
    }' "$1"
}

# check_of <task line>: the command in backticks after "check:", or nothing.
# "check: manual: ..." has no backticks, so it gives nothing.
check_of() {
  printf '%s\n' "$1" | awk '{
    i = index($0, "check:"); if (!i) exit
    rest = substr($0, i + 6)
    if (rest ~ /^[[:space:]]*manual:/) exit
    if (match(rest, /`[^`]+`/)) print substr(rest, RSTART + 1, RLENGTH - 2)
  }'
}

# done: the only way a task gets ticked. Runs the task's check from the
# repository root and ticks the task only when the check exits 0. A baseline
# spec has no tasks: its acceptance criteria in spec.md are ticked the same way.
cmd_done() {
  [ $# -ge 2 ] || { usage >&2; exit 1; }
  local id dir f t ac="" row tab n line cmd note="" rc tmp crlf frozen
  id=$(norm_id "$1")
  case $2 in [Aa][Cc]*) ac=1; t=$(norm_ac "$2") ;; *) t=$(norm_task "$2") ;; esac
  shift 2
  if [ "${1:-}" = --manual ]; then
    note="${2:-}"
    [ -n "$note" ] || { echo "--manual needs a note: who checked what" >&2; exit 1; }
  elif [ $# -gt 0 ]; then
    echo "unknown option '$1'" >&2; exit 1
  fi
  dir=$(spec_dir "$id")
  if [ -n "$ac" ]; then
    f="$dir/spec.md"
    [ "$(fm "$f" type)" = baseline ] \
      || { echo "$id is not a baseline spec; only baseline acceptance criteria are ticked with jsdd done" >&2; exit 1; }
    [ -d "$CLAIMS/$id" ] && mine "$id" \
      || { echo "claim $id first: jsdd claim $id" >&2; exit 1; }
  else
    f="$dir/tasks.md"
    [ -f "$f" ] || { echo "$id has no tasks.md" >&2; exit 1; }
    [ -d "$CLAIMS/$id-$t" ] && mine "$id-$t" \
      || { echo "claim $id $t first: jsdd claim $id $t" >&2; exit 1; }
  fi
  row=$(task_line "$f" "$t")
  [ -n "$row" ] || { echo "$id has no task $t" >&2; exit 1; }
  tab=$'\t'; n=${row%%"$tab"*}; line=${row#*"$tab"}
  case $line in *"- [x]"*|*"- [X]"*)
    # A tick whose claim could not be marked done (remote unreachable): mark it now.
    if [ -z "$ac" ] && [ ! -f "$CLAIMS/$id-$t/done" ]; then
      claim_mark_done "$id-$t" || exit 1
      echo "$id $t is already ticked; marked its claim done"; return
    fi
    echo "$id $t is already ticked" >&2; exit 1 ;;
  esac
  cmd=$(check_of "$line")
  # Checks frozen at plan approval (see "freeze") cannot change quietly.
  if [ -z "$ac" ] && [ -f "$dir/checks.lock" ]; then
    frozen=$(lock_get "$dir/checks.lock" "$t")
    if [ -z "$frozen" ]; then
      echo "$id $t is not in checks.lock: have the reviewer approve the new task, then run: jsdd freeze $id" >&2; exit 1
    elif [ "$frozen" != "${cmd:-manual}" ]; then
      echo "the check of $id $t changed since the plan was approved: frozen \`$frozen\`, now \`${cmd:-manual}\`." >&2
      echo "Put the frozen check back, or record a Deviation naming $t and run: jsdd freeze $id --accept $t" >&2
      exit 1
    fi
  fi

  if [ -n "$cmd" ]; then
    [ -z "$note" ] || { echo "$id $t has a check command; --manual is only for manual checks" >&2; exit 1; }
    echo "check: $cmd"
    rc=0; (cd "$ROOT" && bash -c "$cmd") || rc=$?
    if [ $rc -ne 0 ]; then
      echo "check failed (exit $rc); $id $t not ticked" >&2; exit 1
    fi
  elif [ -z "$note" ]; then
    echo "$id $t has no check command in backticks after 'check:'." >&2
    echo "For a manual check, run: jsdd done $id $t --manual \"<who checked what>\"" >&2
    exit 1
  fi

  # Tick only that line; a manual check keeps its note on the task. A CRLF file
  # stays CRLF. tr counts the CRs: awk in Git Bash drops them as it reads.
  tmp="$f.tmp.$$"
  crlf=0; [ "$(tr -cd '\r' <"$f" | wc -c)" -gt 0 ] && crlf=1
  NOTE="$note" DATE="$(date +%F)" awk -v n="$n" -v crlf="$crlf" '
    { sub(/\r$/, "") }
    NR == n {
      sub(/- \[ \]/, "- [x]")
      if (ENVIRON["NOTE"] != "") $0 = $0 " · checked: " ENVIRON["NOTE"] " (" ENVIRON["DATE"] ")"
    }
    { printf "%s%s\n", $0, (crlf ? "\r" : "") }' "$f" > "$tmp" && mv "$tmp" "$f"
  if [ -n "$cmd" ]; then echo "check passed; ticked $id $t"; else echo "ticked $id $t (manual check recorded)"; fi
  [ -n "$ac" ] || claim_mark_done "$id-$t" || exit 1
  if [ -z "$ac" ] && [ "$(task_note "$id" "$f")" = "all tasks done" ]; then
    echo "every task of $id is ticked; next: /jsdd:verify $id"
  fi
}

# list_claims [all]: active claims, or with "all" also done markers.
list_claims() {
  local c name
  for c in "$CLAIMS"/[0-9]*/; do
    [ -d "$c" ] || continue
    name=$(basename "$c")
    if [ -f "$c/done" ]; then
      [ "${1:-}" = all ] || continue
      printf '  %-8s done     %s\n' "${name/-/ }" "$(claim_desc "$name")"
    else
      printf '  %-8s claimed  %s\n' "${name/-/ }" "$(claim_desc "$name")"
    fi
  done
}

# on_main <ID>: the spec's folder is on the main branch (local, or the claims
# remote's), so every worktree sees it once it syncs. Set $SDD_MAIN_BRANCH if
# it is not main.
on_main() {
  local ref
  for ref in "$MAIN_BRANCH" "$CLAIMS_REMOTE/$MAIN_BRANCH"; do
    (cd "$SPECS_DIR" && git ls-tree --name-only "$ref" -- . 2>/dev/null) \
      | grep -q "^$1-" && return 0
  done
  return 1
}

# prune: drop claims whose spec is done or dropped, done markers whose task is
# ticked, and ID reservations whose spec is on main. A spec made in another
# worktree lives only on that branch until it is merged, so a claim or
# reservation whose spec is not visible is kept: it may be live. Local mode
# reads the specs in this checkout; remote mode reads them on the remote's main
# branch, which every clone sees, so a tick on one person's branch never frees a
# task for the others. Abandoned claims show as stale instead; release them
# with --force.
prune_claims() {
  local c name id dir status t spec tasks tmp="$CLAIMS.prune.$$" base
  mkdir -p "$tmp"
  for c in "$CLAIMS"/*/; do
    [ -d "$c" ] || continue
    c=${c%/}; name=$(basename "$c")
    case $name in
      id-*) if on_main "${name#id-}"; then claim_drop "$name" || true; fi; continue ;;
    esac
    id=${name%%-*}
    if remote_mode; then
      base=$(git -C "$ROOT" ls-tree --name-only "refs/remotes/$CLAIMS_REMOTE/$MAIN_BRANCH" -- specs/ 2>/dev/null \
        | sed 's|^specs/||' | grep "^$id-" | head -1) || true
      [ -n "$base" ] || continue
      spec="$tmp/spec.md"; tasks="$tmp/tasks.md"; rm -f "$spec" "$tasks"
      git -C "$ROOT" show "refs/remotes/$CLAIMS_REMOTE/$MAIN_BRANCH:specs/$base/spec.md" > "$spec" 2>/dev/null || continue
      git -C "$ROOT" show "refs/remotes/$CLAIMS_REMOTE/$MAIN_BRANCH:specs/$base/tasks.md" > "$tasks" 2>/dev/null || rm -f "$tasks"
    else
      dir=$(spec_dir "$id" 2>/dev/null) || continue
      spec="$dir/spec.md"; tasks="$dir/tasks.md"
    fi
    status=$(fm "$spec" status)
    case $status in done|dropped) claim_drop "$name" || true; continue ;; esac
    case $name in *-T*) ;; *) continue ;; esac
    [ -f "$c/done" ] && [ -f "$tasks" ] || continue
    t=${name#*-}
    if [ "$(task_rows "$id" "$tasks" | awk -v t="$t" '$1 == t { print $2 }')" = 1 ]; then claim_drop "$name" || true; fi
  done
  rm -rf "$tmp"
  return 0
}

cmd_claims() {
  local out c held=""
  case ${1:-} in
    --prune) prune_claims ;;
    --mine)
      # The claims this session still holds: what the Stop hook warns about.
      for c in "$CLAIMS"/[0-9]*/; do
        [ -d "$c" ] && [ ! -f "$c/done" ] || continue
        mine "$(basename "$c")" && held="$held $(basename "$c")"
      done
      [ -z "$held" ] || echo "${held# }"
      return 0 ;;
    "") ;;
    *) echo "usage: jsdd claims [--prune | --mine]" >&2; exit 1 ;;
  esac
  claims_banner
  local_leftovers
  out=$(list_claims all)
  printf '%s\n' "${out:-  (no claims)}"
}

# --- requirement coverage -------------------------------------------------
# Requirement rows are the table rows of $REQUIREMENTS whose first cell is an
# ID like FR-AUTH-05 or NFR-SEC-03. A row with four cells (ID, text, source,
# priority) has a priority; NFR rows have none. A spec covers a requirement
# when its `refs` name the requirement's ID. A requirement is done when every
# spec covering it (dropped ones aside) is done: a live spec that changes a row
# a baseline already proved puts the row back in progress.

REQUIREMENTS="${SDD_REQUIREMENTS:-$ROOT/docs/requirements.md}"
PLAN_FILE="$ROOT/PLAN.md"
REQ_ID_RE='(FR|NFR)-[A-Z0-9]+(-[0-9]+[a-z]?)?'

# spec_refs: one line per spec: id, status, requirement IDs in its refs (space separated).
spec_refs() {
  local d spec ids
  for d in "$SPECS_DIR"/[0-9][0-9][0-9]-*/; do
    spec="${d%/}/spec.md"
    [ -f "$spec" ] || continue
    ids=$(fm "$spec" refs | grep -oE "$REQ_ID_RE" | tr '\n' ' ' || true)
    printf '%s\t%s\t%s\n' "$(fm "$spec" id)" "$(fm "$spec" status)" "$ids"
  done
}

# phase_scope <N>: the requirement IDs and groups that PLAN.md's "## Phase N" section names.
phase_scope() {
  [ -f "$PLAN_FILE" ] || { echo "no PLAN.md for --phase" >&2; exit 1; }
  awk -v p="$1" '
    { sub(/\r$/, "") }
    /^## / { on = (index($0, "## Phase " p ":") == 1 || $0 == "## Phase " p) ; next }
    on' "$PLAN_FILE" | grep -oE "$REQ_ID_RE" | sort -u | tr '\n' ' '
}

# coverage_rows: id, priority, specs ("007:done,009:draft" or "-"), state, text.
# state: done (only done specs cover it), spec (a live spec covers it), none.
coverage_rows() {
  [ -f "$REQUIREMENTS" ] || { echo "no requirements file at $REQUIREMENTS (set SDD_REQUIREMENTS)" >&2; exit 1; }
  spec_refs | SCOPE="${1:-}" awk -F '\t' '
    FILENAME == "-" {
      n = split($3, ids, " ")
      for (i = 1; i <= n; i++) if ($2 != "dropped") {
        specs[ids[i]] = specs[ids[i]] (specs[ids[i]] ? "," : "") $1 ":" $2
        if ($2 == "done") done[ids[i]] = 1; else live[ids[i]] = 1
      }
      next
    }
    { sub(/\r$/, "") }
    /^\| *N?FR-[A-Z0-9]+-[0-9]+[a-z]? *\|/ {
      nf = split($0, c, "|")
      id = c[2]; gsub(/^ +| +$/, "", id)
      if (ENVIRON["SCOPE"] != "" && !inscope(id)) next
      text = c[3]; gsub(/\*\*/, "", text); gsub(/^ +| +$/, "", text)
      pri = "-"
      if (nf == 6) { pri = c[5]; gsub(/ /, "", pri); if (pri !~ /^[MSCW]$/) pri = "-" }
      state = (id in done && !(id in live)) ? "done" : ((id in specs) ? "spec" : "none")
      printf "%s\t%s\t%s\t%s\t%s\n", id, pri, (id in specs ? specs[id] : "-"), state, text
    }
    # A scope entry is an exact ID or a group prefix such as FR-SES.
    function inscope(id,   n, s, i) {
      n = split(ENVIRON["SCOPE"], s, " ")
      for (i = 1; i <= n; i++) if (id == s[i] || index(id, s[i] "-") == 1) return 1
      return 0
    }' - "$REQUIREMENTS"
}

# coverage_summary <rows>: one line per priority: covered by a spec, and done.
coverage_summary() {
  awk -F '\t' '
    { t[$2]++; if ($4 != "none") s[$2]++; if ($4 == "done") d[$2]++ }
    END {
      split("M S C W -", order, " "); name["M"] = "Must"; name["S"] = "Should"; name["C"] = "Could"; name["W"] = "Won'"'"'t"; name["-"] = "No priority (NFRs)"
      for (i = 1; i <= 5; i++) { p = order[i]; if (t[p]) printf "  %-19s %3d   with a spec %3d   done %3d\n", name[p], t[p], s[p] + 0, d[p] + 0 }
    }'
}

cmd_coverage() {
  local scope="" pri="" missing="" rows
  while [ $# -gt 0 ]; do
    case $1 in
      --phase) [ $# -ge 2 ] || { usage >&2; exit 1; }; scope="$scope $(phase_scope "$2")"; shift 2 ;;
      --priority) [ $# -ge 2 ] || { usage >&2; exit 1; }; pri=$2; shift 2 ;;
      --missing) missing=1; shift ;;
      -*) echo "unknown option '$1'" >&2; usage >&2; exit 1 ;;
      *) scope="$scope $1"; shift ;;
    esac
  done
  rows=$(coverage_rows "${scope# }")
  [ -n "$rows" ] || { echo "no requirements in scope"; return; }
  printf '%s\n' "$rows" | coverage_summary
  echo
  printf '%s\n' "$rows" | PRI="$pri" MISSING="$missing" awk -F '\t' '
    ENVIRON["PRI"] != "" && $2 != ENVIRON["PRI"] { next }
    ENVIRON["MISSING"] != "" && $4 != "none" { next }
    {
      if (!shown++) { print "| Requirement | Pri | Specs | Text |"; print "| --- | --- | --- | --- |" }
      t = $5; if (length(t) > 70) t = substr(t, 1, 67) "..."
      printf "| %s | %s | %s | %s |\n", $1, $2, ($3 == "-" ? "" : $3), t
    }
    END { if (!shown) print "  (no requirements match)" }'
}

# --- capabilities ----------------------------------------------------------
# A capability document, docs/capabilities/<group>.md, says how one
# requirement group works now: one "## <row ID> · <text>" entry per row, with a
# "Last changed: NNN" line, and a History table (date, spec, row, change). A
# spec's "## Capability changes" table (row, adds|modifies|removes, Rs) is
# merged into it by /jsdd:verify when the spec closes; this checks the merge.
# A baseline adds every row in its refs.

CAP_DIR="$ROOT/docs/capabilities"
CAP_ID_RE='^N?FR-[A-Z0-9]+-[0-9]+[a-z]?$'

# cap_changes: C, spec id, status, row, change for each Capability changes line.
# A baseline has no table: each row in its refs is an "adds".
cap_changes() {
  local d spec r
  for d in "$SPECS_DIR"/[0-9][0-9][0-9]-*/; do
    spec="${d%/}/spec.md"
    [ -f "$spec" ] || continue
    if [ "$(fm "$spec" type)" = baseline ]; then
      for r in $(fm "$spec" refs | grep -oE '(FR|NFR)-[A-Z0-9]+-[0-9]+[a-z]?' || true); do
        printf 'C\t%s\t%s\t%s\tadds\n' "$(fm "$spec" id)" "$(fm "$spec" status)" "$r"
      done
      continue
    fi
    uncomment "$spec" | ID="$(fm "$spec" id)" ST="$(fm "$spec" status)" RE="$CAP_ID_RE" awk -F '|' '
      /^## / { on = ($0 ~ /^## Capability changes/); next }
      on && NF >= 4 {
        row = $2; ch = tolower($3); gsub(/^ +| +$/, "", row); gsub(/^ +| +$/, "", ch)
        if (row ~ ENVIRON["RE"]) printf "C\t%s\t%s\t%s\t%s\n", ENVIRON["ID"], ENVIRON["ST"], row, ch
      }'
  done
}

# cap_docs: E, row, last-changed spec, file for each entry, and H, row, spec,
# change, file for each History row, of every capability document.
cap_docs() {
  local f
  for f in "$CAP_DIR"/*.md; do
    [ -f "$f" ] || continue
    uncomment "$f" | F="$(basename "$f")" RE="$CAP_ID_RE" awk -F '|' '
      function flush() { if (row != "") printf "E\t%s\t%s\t%s\n", row, (last == "" ? "-" : last), ENVIRON["F"]; row = "" }
      /^## / {
        flush(); hist = ($0 ~ /^## History/)
        h = substr($0, 4); sub(/ .*/, "", h)
        if (!hist && h ~ ENVIRON["RE"]) { row = h; last = "" }
        next
      }
      row != "" && /^Last changed:/ { last = $0; sub(/^Last changed: */, "", last); sub(/[^0-9].*/, "", last) }
      hist && NF >= 6 {
        s = $3; r = $4; ch = tolower($5); gsub(/^ +| +$/, "", s); gsub(/^ +| +$/, "", r); gsub(/^ +| +$/, "", ch)
        if (r ~ ENVIRON["RE"] && s ~ /^[0-9][0-9][0-9]$/) printf "H\t%s\t%s\t%s\t%s\n", r, s, ch, ENVIRON["F"]
      }
      END { flush() }'
  done
}

cmd_capabilities() {
  local scope="" check="" out
  while [ $# -gt 0 ]; do
    case $1 in
      --check) check=1; shift ;;
      -*) echo "unknown option '$1'" >&2; usage >&2; exit 1 ;;
      *) scope="$scope $1"; shift ;;
    esac
  done
  [ -f "$REQUIREMENTS" ] || { echo "no requirements file at $REQUIREMENTS (set SDD_REQUIREMENTS)" >&2; exit 1; }
  out=$({
    coverage_rows | awk -F '\t' '{ printf "R\t%s\t%s\n", $1, $5 }'
    cap_changes
    cap_docs
  } | SCOPE="${scope# }" awk -F '\t' '
    # A scope entry is an exact ID or a group prefix such as FR-SES.
    function inscope(id,   n, s, i) {
      if (ENVIRON["SCOPE"] == "") return 1
      n = split(ENVIRON["SCOPE"], s, " ")
      for (i = 1; i <= n; i++) if (id == s[i] || index(id, s[i] "-") == 1) return 1
      return 0
    }
    !inscope($1 == "C" ? $4 : $2) { next }
    $1 == "R" { rows[++nr] = $2; isrow[$2] = 1; text[$2] = $3 }
    $1 == "C" {
      if ($3 == "dropped") next
      if ($3 == "done") { donech[++nd] = $2 "\t" $4 "\t" $5 }
      else pending[$4] = pending[$4] (pending[$4] ? ", " : "") $2 " " $5 " (" $3 ")"
    }
    $1 == "E" { entry[$2] = $4; last[$2] = $3; if (!($2 in isrow)) orphan[++no] = $2 "\t" $4 }
    $1 == "H" { merged[$3 "\t" $2] = 1; lastch[$2] = $4 }
    END {
      for (i = 1; i <= nr; i++) {
        r = rows[i]
        if (!(r in entry) && !(r in pending)) continue
        if (!shown++) { print "| Requirement | Entry | Last changed | Pending changes |"; print "| --- | --- | --- | --- |" }
        printf "| %s | %s | %s | %s |\n", r, (r in entry ? entry[r] : ""), (r in entry ? last[r] : ""), pending[r]
      }
      if (!shown) print "  (no capability entries or pending changes)"
      for (i = 1; i <= nd; i++) {
        split(donech[i], c, "\t")
        if (!((c[1] "\t" c[2]) in merged)) problems[++np] = "not merged: " c[1] " " c[3] " " c[2] " (no History row)"
      }
      for (r in entry) if (lastch[r] == "removes") problems[++np] = r ": removed, but its entry is still in " entry[r]
      for (i = 1; i <= no; i++) { split(orphan[i], c, "\t"); problems[++np] = c[1] ": entry in " c[2] " has no row in the requirements" }
      if (np) { print ""; print "Problems:"; for (i = 1; i <= np; i++) print "  " problems[i] }
    }')
  printf '%s\n' "$out"
  if [ -n "$check" ] && printf '%s\n' "$out" | grep -q '^Problems:'; then exit 1; fi
  return 0
}

# --- runtime modes ---------------------------------------------------------
# A runtime mode says what happens at each gate: a decision point in a skill
# where a person decides today. A gate's policy is one of
#   ask   a person decides, as the skill says (every gate in manual mode)
#   auto  the gate's machine resolver passes it (a check, a reviewer, a rule);
#         when it cannot, the gate parks
#   park  nobody is asked and nothing is guessed: the work waits
# The project allows modes and tunes their gates in specs/jsdd.yml; a person
# picks one with $SDD_MODE. A mode that needs consent is never a project
# default. Anything invalid falls back to manual, so a mistake asks more, never less.
# $SDD_PREVIEW_MODES=1 lets a mode that is not available yet resolve, for the
# kit's own tests: the skills still stop in a mode they do not support.
# autopilot: the person authors and approves the spec, then /jsdd:auto runs
# plan, implement, and verify to a pull request with nobody asked; what no
# machine check can settle parks (see "parking" and "autopilot runs" below).

MODES_FILE="$SPECS_DIR/jsdd.yml"
MODES_REL="specs/jsdd.yml"

# mode  needs-consent  available-in-this-version
MODE_TABLE='manual      no   yes
autonomous  yes  yes
autopilot   yes  yes'

# gate, allowed policies, the policy in each mode of MODE_TABLE (in order), then
# what it decides and which skills reach it. A new mode adds a column; a new gate a row.
GATES='spec.split               ask|auto|park  ask  auto  ask   Split a spec larger than a few days into several (specify)
spec.clarify             ask|auto|park  ask  auto  ask   Answer a [NEEDS CLARIFICATION] question about behavior (specify; autonomous: sdd-product, up to the product class of the charter)
depends.override         ask|park       ask  park  park  Go ahead while a spec in depends_on is not done (plan, spike)
spec.approve             ask|auto|park  ask  auto  auto  Approve a spec for planning (plan)
plan.approve             ask|auto|park  ask  auto  auto  Approve a plan or amendment for implementing (implement)
implement.stuck          ask|auto|park  ask  auto  auto  Fix a failing check, a wrong plan, or a decision the plan lacks (implement)
spec.change              ask|auto|park  ask  park  park  Change behavior, scope, or ACs of an approved spec (implement, verify; autonomous auto: sdd-product decides)
task.manual_check        ask|park       ask  park  park  Do a check: manual: on a task or acceptance criterion (implement, verify)
commit                   ask|auto       ask  auto  auto  Commit each finished task (implement)
verify.gaps              ask|auto|park  ask  auto  auto  Approve, change, or drop the fixes a verification proposes (verify, plan)
verify.gap_option        ask|auto|park  ask  auto  auto  Pick one option on a gap that has several (verify, plan)
verify.partial_ref       ask|auto|park  ask  auto  park  Split or drop a requirement the work only partly delivers (verify)
verify.capability_merge  ask|auto|park  ask  auto  park  Merge into a capability entry another spec changed since approval (verify)
baseline.rows            ask|auto|park  ask  auto  ask   Confirm the behavior rows a survey found (baseline)
spike.question           ask|park       ask  park  ask   Answer a spike question only the owner can answer (spike)
merge                    ask|auto|park  ask  park  park  Merge the pull request of a converged spec once CI is green (auto; autopilot always stops at the pull request)
pr.open                  ask|auto|park  ask  auto  auto  Push the run branch and open a pull request for review (auto)'

# Budgets cap an unattended run: name, lowest, highest, default, what it caps.
# A mode section in specs/jsdd.yml may set them, like its gates.
BUDGETS='attempts_per_task  1  10  3  Tries at one task, or at fixing one failing check, before it parks
wall_time_hours    1  24  4  Hours a run (or an autonomous loop) may take before it stops and says where it is
specs_per_run      1  20  3  Specs an autonomous loop takes before it stops'
budget_row() { printf '%s\n' "$BUDGETS" | awk -v b="$1" '$1 == b'; }

# Presets of the autonomous mode: preset, then its product class (how far the
# sdd-product agent's answers may be acted on) and the gates it changes from the
# catalog's autonomous column. A key the project sets in its autonomous section
# wins over the preset.
PRESETS='cautious   product=cited
standard   product=inferred
hands-off  product=all spec.change=auto merge=auto'
# Product classes, weakest basis last: an answer of a class above the charter's
# product setting parks. park: every product question parks.
PRODUCT_CLASSES='park cited inferred uncited all'
preset_names() { printf '%s\n' "$PRESETS" | awk '{ printf "%s%s", (NR > 1 ? ", " : ""), $1 }'; }
# preset_gate <preset> <gate>: the preset's policy for the gate, or nothing.
preset_gate() { printf '%s\n' "$PRESETS" | awk -v p="$1" -v g="$2" '$1 == p { for (i = 2; i <= NF; i++) if (index($i, g "=") == 1) print substr($i, length(g) + 2) }'; }

# The autonomous section also says what a loop may take (the charter's scope):
# key, what its value is. Lists are inline, like [1, 2].
SCOPE_KEYS='product         How far the sdd-product agent may decide: park, cited, inferred, uncited, all
phases          PLAN.md phases a loop takes specs from (default: every phase)
types           Spec types a loop takes: feature, baseline, spike (default: [feature])
exclude_groups  Requirement groups a loop never touches, like [FR-BILLING]'
scope_row() { printf '%s\n' "$SCOPE_KEYS" | awk -v k="$1" '$1 == k'; }

mode_names() { printf '%s\n' "$MODE_TABLE" | awk '{ printf "%s%s", (NR > 1 ? ", " : ""), $1 }'; }
# mode_field <mode> <2|3>: needs-consent or available; empty for an unknown mode.
mode_field() { printf '%s\n' "$MODE_TABLE" | awk -v m="$1" -v f="$2" '$1 == m { print $f }'; }
mode_index() { printf '%s\n' "$MODE_TABLE" | awk -v m="$1" '$1 == m { print NR }'; }
gate_row() { printf '%s\n' "$GATES" | awk -v g="$1" '$1 == g'; }
gate_names() { printf '%s\n' "$GATES" | awk '{ print $1 }'; }

# config_lines: specs/jsdd.yml parsed, one tab-separated line per entry:
#   S <line> <section>                     a section header (a mode's name)
#   K <line> <section or -> <key> <value>  a key; - for the top level
#   ! <line> <message>                     a line that is not in the supported subset
# The subset: top-level keys and sections one level deep, scalar values and
# inline lists, # comments. Nothing else in YAML is read.
config_lines() {
  [ -f "$MODES_FILE" ] || return 0
  awk '
    { sub(/\r$/, ""); line = $0 }
    { sub(/^[ \t]*#.*/, "", line); sub(/[ \t]+#.*$/, "", line); sub(/[ \t]+$/, "", line) }
    line == "" { next }
    line ~ /^ *\t/ { printf "!\t%d\ttabs cannot indent; use spaces\n", NR; next }
    {
      ind = match(line, /[^ ]/) - 1
      body = substr(line, ind + 1)
      i = index(body, ":")
      if (!i) { printf "!\t%d\texpected key: value\n", NR; next }
      k = substr(body, 1, i - 1); v = substr(body, i + 1)
      gsub(/^[ \t]+|[ \t]+$/, "", k); gsub(/^[ \t]+|[ \t]+$/, "", v)
      if (k == "" || k ~ /[ \t"'\'']/) { printf "!\t%d\texpected key: value\n", NR; next }
      if (length(v) >= 2 && (v ~ /^".*"$/ || v ~ /^'\''.*'\''$/)) v = substr(v, 2, length(v) - 2)
      if (ind == 0) {
        if (v == "") { sec = k; printf "S\t%d\t%s\n", NR, k }
        else { sec = ""; printf "K\t%d\t-\t%s\t%s\n", NR, k, v }
      } else if (sec == "") printf "!\t%d\tindented line outside a section\n", NR
      else if (v == "") printf "!\t%d\tsections are one level deep: %s.%s needs a value\n", NR, sec, k
      else printf "K\t%d\t%s\t%s\t%s\n", NR, sec, k, v
    }' "$MODES_FILE"
}

# load_config: parse specs/jsdd.yml once per run into CONFIG.
load_config() { [ -n "${CONFIG_LOADED:-}" ] || { CONFIG=$(config_lines); CONFIG_LOADED=1; }; }
# config_get <section or -> <key>
config_get() { printf '%s\n' "$CONFIG" | awk -F '\t' -v s="$1" -v k="$2" '$1 == "K" && $3 == s && $4 == k { print $5; exit }'; }
# list_items <[a, b]>: one item per line; fails unless the value is an inline list.
list_items() {
  case $1 in \[*\]) ;; *) return 1 ;; esac
  printf '%s' "$1" | sed 's/^\[//; s/\]$//' | tr ',' '\n' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//' | sed '/^$/d'
}
# mode_allowed <mode>: manual always; any other mode only when modes: lists it.
mode_allowed() {
  [ "$1" = manual ] && return 0
  list_items "$(config_get - modes)" 2>/dev/null | grep -qx "$1"
}

# config_errors: one line per problem in specs/jsdd.yml; nothing when it is
# valid or missing. Unknown keys and values are errors, never ignored.
config_errors() {
  load_config
  [ -f "$MODES_FILE" ] || return 0
  local f=$MODES_REL t n s k v seen="|" row allowed m version="" default="" dline=""
  while IFS="$(printf '\t')" read -r t n s k v; do
    case $t in
      '!') echo "$f:$n: $s" ;;
      S)
        case $seen in *"|$s|"*) echo "$f:$n: '$s' appears twice" ;; esac
        seen="$seen$s|"
        if [ -z "$(mode_field "$s" 2)" ]; then echo "$f:$n: unknown key '$s' (a section must be a mode: $(mode_names))"
        elif [ "$s" = manual ]; then echo "$f:$n: manual cannot be changed: every gate in it asks"
        fi ;;
      K)
        case $seen in *"|$s.$k|"*) echo "$f:$n: '$k' appears twice" ;; esac
        seen="$seen$s.$k|"
        if [ "$s" = - ]; then
          case $k in
            version) version=$v; [ "$v" = 1 ] || echo "$f:$n: version must be 1" ;;
            modes)
              if ! list_items "$v" >/dev/null; then echo "$f:$n: modes must be a list, like [manual, autonomous]"
              else
                for m in $(list_items "$v"); do
                  [ -n "$(mode_field "$m" 2)" ] || echo "$f:$n: unknown mode '$m' (modes: $(mode_names))"
                done
              fi ;;
            default) default=$v; dline=$n ;;
            *)
              if [ -n "$(mode_field "$k" 2)" ]; then echo "$f:$n: '$k' is a section: put its gates on the lines below it"
              else echo "$f:$n: unknown key '$k' (top-level keys: version, modes, default, and one section per mode)"; fi ;;
          esac
        elif [ "$k" = preset ] || [ -n "$(scope_row "$k")" ]; then
          if [ "$s" != autonomous ]; then echo "$f:$n: $k belongs in the autonomous section only"
          elif [ "$k" = preset ]; then
            printf '%s\n' "$PRESETS" | awk -v p="$v" '$1 == p { ok = 1 } END { exit !ok }' \
              || echo "$f:$n: autonomous.preset: '$v' is not one of $(preset_names)"
          elif [ "$k" = product ]; then
            case " $PRODUCT_CLASSES " in *" $v "*) ;; *) echo "$f:$n: autonomous.product: '$v' is not one of $(printf '%s' "$PRODUCT_CLASSES" | sed 's/ /, /g')" ;; esac
          elif ! list_items "$v" >/dev/null; then echo "$f:$n: autonomous.$k must be a list, like [$(case $k in phases) echo 1 ;; types) echo feature ;; *) echo FR-BILLING ;; esac)]"
          else
            for m in $(list_items "$v"); do
              case $k in
                phases) case $m in *[!0-9]*) echo "$f:$n: autonomous.phases: '$m' is not a phase number" ;; esac ;;
                types) case $m in feature|baseline|spike) ;; *) echo "$f:$n: autonomous.types: '$m' is not one of feature, baseline, spike" ;; esac ;;
                exclude_groups) printf '%s' "$m" | grep -Eq '^N?FR-[A-Z0-9]+$' || echo "$f:$n: autonomous.exclude_groups: '$m' is not a requirement group like FR-BILLING" ;;
              esac
            done
          fi
        else
          row=$(gate_row "$k")
          if [ -z "$row" ] && [ -n "$(budget_row "$k")" ]; then
            budget_row "$k" | { read -r _ lo hi _; case $v in ""|*[!0-9]*) false ;; *) [ "$v" -ge "$lo" ] && [ "$v" -le "$hi" ] ;; esac; } \
              || echo "$f:$n: $s.$k: '$v' is not a whole number from $(budget_row "$k" | awk '{ print $2 " to " $3 }')"
          elif [ -z "$row" ]; then echo "$f:$n: unknown gate '$k' in $s (gates and budgets: jsdd mode --explain$([ "$s" != autonomous ] || echo "; also preset, product, phases, types, exclude_groups"))"
          else
            allowed=$(printf '%s' "$row" | awk '{ print $2 }')
            case "|$allowed|" in *"|$v|"*) ;; *) echo "$f:$n: $s.$k: '$v' is not one of $(printf '%s' "$allowed" | sed 's/|/, /g')" ;; esac
          fi
        fi ;;
    esac
  done <<EOF
$CONFIG
EOF
  [ -n "$version" ] || echo "$f: add 'version: 1'"
  if [ -n "$default" ]; then
    if [ -z "$(mode_field "$default" 2)" ]; then echo "$f:$dline: unknown mode '$default' (modes: $(mode_names))"
    elif [ "$(mode_field "$default" 2)" = yes ]; then echo "$f:$dline: default cannot be $default: it needs consent, so each person picks it with SDD_MODE"
    elif ! mode_allowed "$default"; then echo "$f:$dline: default $default is not listed in modes"
    fi
  fi
}

# resolve_mode: sets MODE (the effective mode), MODE_SOURCE (where it came
# from), MODE_WARN (why a requested mode was not used), and CONFIG_ERRORS.
resolve_mode() {
  local want src
  load_config
  CONFIG_ERRORS=$(config_errors)
  MODE_WARN=""
  if [ -n "${SDD_MODE:-}" ]; then want=$SDD_MODE; src="SDD_MODE"
  elif [ -z "$CONFIG_ERRORS" ] && [ -n "$(config_get - default)" ]; then want=$(config_get - default); src="$MODES_REL default"
  else want=manual; src="built-in default"
  fi
  MODE=manual; MODE_SOURCE="fallback"
  if [ -n "$CONFIG_ERRORS" ]; then MODE_WARN="$MODES_REL is invalid, so every gate asks (run: jsdd mode --check)"
  elif [ -z "$(mode_field "$want" 2)" ]; then MODE_WARN="SDD_MODE=$want is not a mode ($(mode_names)), so every gate asks"
  elif ! mode_allowed "$want"; then MODE_WARN="$want mode is not allowed here: $MODES_REL does not list it under modes, so every gate asks"
  elif [ "$(mode_field "$want" 3)" != yes ] && [ "${SDD_PREVIEW_MODES:-}" != 1 ]; then MODE_WARN="$want mode is not available yet in this version of jsdd, so every gate asks"
  else MODE=$want; MODE_SOURCE=$src
  fi
}

# gate_policy <gate> <mode>: the project's override for the mode, else the catalog's.
gate_policy() {
  local v
  [ "$2" = manual ] && { echo ask; return; }
  v=$(config_get "$2" "$1")
  [ -n "$v" ] || [ "$2" != autonomous ] || v=$(preset_gate "$(autonomous_preset)" "$1")
  if [ -n "$v" ]; then echo "$v"; else gate_row "$1" | awk -v c="$(( $(mode_index "$2") + 2 ))" '{ print $c }'; fi
}

# autonomous_preset: the project's preset; cautious when none is set.
autonomous_preset() { local p; p=$(config_get autonomous preset); echo "${p:-cautious}"; }

# mode_banner: the lines the board starts with when the mode is not plain manual.
mode_banner() {
  if [ "$MODE" = autonomous ]; then
    printf 'MODE: autonomous, preset %s, product %s (from %s). Gates pass or park without asking you; parked specs wait under "Waiting for you": jsdd charter\n' "$(autonomous_preset)" "$(scope_value product)" "$MODE_SOURCE"
  elif [ "$MODE" != manual ]; then
    printf 'MODE: %s (from %s). Some gates pass or park without asking you: jsdd mode --explain\n' "$MODE" "$MODE_SOURCE"
  fi
  [ -z "$MODE_WARN" ] || printf 'Mode warning: %s\n' "$MODE_WARN"
  local n; n=$(assumed_count)
  [ "$n" -eq 0 ] || printf 'Assumed decisions: %s made by autonomous runs wait for the owner to confirm or reject (docs/decisions.md, Assumed)\n' "$n"
}

# assumed_count: rows in the Assumed section of docs/decisions.md, which the
# sdd-product agent's decisions go to until the owner confirms or rejects them.
assumed_count() {
  local f="$ROOT/docs/decisions.md"
  [ -f "$f" ] || { echo 0; return; }
  section "$f" Assumed | grep -cE '^\| *AS-[0-9]+' || true
}

cmd_mode() {
  local g p over
  resolve_mode
  case "${1:-}" in
    "")
      echo "mode: $MODE ($MODE_SOURCE)"
      [ -z "$MODE_WARN" ] || echo "warning: $MODE_WARN" ;;
    --check)
      if [ -n "$CONFIG_ERRORS" ]; then printf '%s\n' "$CONFIG_ERRORS"
      elif [ -f "$MODES_FILE" ]; then echo "$MODES_REL: ok"
      else echo "no $MODES_REL: only manual mode, every gate asks"
      fi
      echo "mode: $MODE ($MODE_SOURCE)"
      [ -z "$MODE_WARN" ] || echo "warning: $MODE_WARN"
      [ -z "$CONFIG_ERRORS" ] && [ -z "$MODE_WARN" ] ;;
    --explain)
      echo "mode: $MODE ($MODE_SOURCE)"
      [ -z "$MODE_WARN" ] || echo "warning: $MODE_WARN"
      echo
      printf '%-24s %-6s %s\n' GATE POLICY "WHAT IT DECIDES"
      for g in $(gate_names); do
        p=$(gate_policy "$g" "$MODE"); over=""
        if [ "$MODE" != manual ] && [ -n "$(config_get "$MODE" "$g")" ]; then over=" [set in $MODES_REL]"
        elif [ "$MODE" = autonomous ] && [ -n "$(preset_gate "$(autonomous_preset)" "$g")" ]; then over=" [preset $(autonomous_preset)]"
        fi
        printf '%-24s %-6s %s%s\n' "$g" "$p" "$(gate_row "$g" | awk -v c="$(( $(printf '%s\n' "$MODE_TABLE" | wc -l) + 3 ))" '{ for (i = c; i <= NF; i++) printf "%s%s", $i, (i < NF ? " " : "") }')" "$over"
      done
      if [ "$MODE" != manual ]; then
        echo
        printf '%-24s %-6s %s\n' BUDGET VALUE "WHAT IT CAPS"
        printf '%s\n' "$BUDGETS" | while read -r g _ _ _ p; do
          over=""; [ -z "$(config_get "$MODE" "$g")" ] || over=" [set in $MODES_REL]"
          printf '%-24s %-6s %s%s\n' "$g" "$(budget_value "$g")" "$p" "$over"
        done
      fi
      if [ "$MODE" = autonomous ]; then
        echo
        echo "preset: $(autonomous_preset)$([ -n "$(config_get autonomous preset)" ] || echo " (none set: the strictest)")"
        printf '%-24s %-22s %s\n' SCOPE VALUE "WHAT IT SAYS"
        printf '%s\n' "$SCOPE_KEYS" | while read -r g p; do
          printf '%-24s %-22s %s\n' "$g" "$(scope_value "$g")" "$p"
        done
      fi ;;
    *) echo "usage: jsdd mode [--check | --explain]" >&2; exit 1 ;;
  esac
}

cmd_gate() {
  [ $# -eq 1 ] || { echo "usage: jsdd gate <gate>   (gates: jsdd mode --explain)" >&2; exit 1; }
  [ -n "$(gate_row "$1")" ] || { echo "unknown gate '$1' (gates: jsdd mode --explain)" >&2; exit 2; }
  resolve_mode
  gate_policy "$1" "$MODE"
}

# budget_value <budget>: the project's value for the current mode, else the default.
budget_value() {
  local v=""
  [ -n "$CONFIG_ERRORS" ] || v=$(config_get "$MODE" "$1")
  if [ -n "$v" ]; then echo "$v"; else budget_row "$1" | awk '{ print $4 }'; fi
}

# scope_value <key>: the autonomous section's list, or its default.
scope_value() {
  local v=""
  [ -n "$CONFIG_ERRORS" ] || v=$(config_get autonomous "$1")
  if [ -n "$v" ]; then echo "$v"
  else case $1 in product) preset_gate "$(autonomous_preset)" product ;; phases) echo "[any]" ;; types) echo "[feature]" ;; *) echo "[]" ;; esac; fi
}

# charter_get <key>: one effective value of the charter: a scope key or preset,
# a budget, or a gate's policy, in autonomous mode.
charter_get() {
  case $1 in
    preset) autonomous_preset ;;
    product|phases|types|exclude_groups) scope_value "$1" ;;
    *)
      if [ -n "$(budget_row "$1")" ]; then MODE=autonomous budget_value "$1"
      elif [ -n "$(gate_row "$1")" ]; then gate_policy "$1" autonomous
      else echo "unknown charter key '$1' (keys: jsdd charter)" >&2; return 1
      fi ;;
  esac
}

cmd_charter() {
  local k g
  resolve_mode
  [ -z "$CONFIG_ERRORS" ] || { printf '%s\n' "$CONFIG_ERRORS" >&2; echo "the charter is invalid: jsdd mode --check" >&2; exit 1; }
  case ${1:-} in
    get) [ $# -eq 2 ] || { echo "usage: jsdd charter get <key>" >&2; exit 1; }; charter_get "$2" ;;
    "")
      if [ -z "$(printf '%s\n' "$CONFIG" | awk -F '\t' '$1 == "S" && $3 == "autonomous"')" ]; then
        echo "no charter: $MODES_REL has no autonomous section, so no autonomous run can start (/jsdd:auto setup writes one)"
        return
      fi
      mode_allowed autonomous || echo "note: $MODES_REL does not list autonomous under modes"
      for k in preset product types phases exclude_groups; do printf '%-18s %s\n' "$k" "$(charter_get "$k")"; done
      printf '%s\n' "$BUDGETS" | while read -r k _; do printf '%-18s %s\n' "$k" "$(charter_get "$k")"; done
      for g in spec.clarify spec.change verify.gap_option merge; do printf '%-18s %s\n' "$g" "$(charter_get "$g")"; done
      echo "(every gate: SDD_MODE=autonomous jsdd mode --explain)" ;;
    *) echo "usage: jsdd charter [get <key>]" >&2; exit 1 ;;
  esac
}

cmd_budget() {
  [ $# -eq 1 ] && [ -n "$(budget_row "$1")" ] \
    || { echo "usage: jsdd budget <$(printf '%s\n' "$BUDGETS" | awk '{ printf "%s%s", (NR > 1 ? "|" : ""), $1 }')>" >&2; exit 1; }
  resolve_mode
  budget_value "$1"
}

# --- frontmatter and changelog edits -----------------------------------------

# fm_set <file> <key> [value]: set a flat frontmatter key to a quoted value, or
# remove it when no value is given. A CRLF file stays CRLF.
fm_set() {
  local f=$1 tmp="$1.tmp.$$" crlf=0 v="" set=""
  [ "$(tr -cd '\r' <"$f" | wc -c)" -gt 0 ] && crlf=1
  if [ $# -ge 3 ]; then set=1; v=$(printf '%s' "$3" | tr '\r\n' '  ' | sed -e 's/[\\"]/\\&/g'); fi
  K="$2" V="$v" SET="$set" awk -v crlf="$crlf" '
    function out(s) { printf "%s%s\n", s, (crlf ? "\r" : "") }
    function put() { if (ENVIRON["SET"] != "" && !done) out(ENVIRON["K"] ": \"" ENVIRON["V"] "\""); done = 1 }
    { sub(/\r$/, "") }
    NR == 1 && $0 == "---" { infm = 1; out($0); next }
    infm && $0 == "---" { put(); infm = 0; out($0); next }
    infm && index($0, ENVIRON["K"] ":") == 1 { put(); next }
    { out($0) }' "$f" > "$tmp" && mv "$tmp" "$f"
}

# changelog_add <spec.md> <text>: append "- <date> <text>" to the Changelog section.
changelog_add() {
  local f=$1 tmp="$1.tmp.$$" crlf=0
  [ "$(tr -cd '\r' <"$f" | wc -c)" -gt 0 ] && crlf=1
  LINE="- $(date +%F) $2" awk -v crlf="$crlf" '
    function out(s) { printf "%s%s\n", s, (crlf ? "\r" : "") }
    function blanks() { for (i = 1; i <= nb; i++) out(""); nb = 0 }
    function flush() { if (on && !added) { out(ENVIRON["LINE"]); added = 1 } blanks() }
    { sub(/\r$/, "") }
    /^## / { flush(); on = ($0 == "## Changelog") }
    $0 == "" { nb++; next }
    { blanks(); out($0) }
    END { flush(); if (!added) { out(""); out("## Changelog"); out(""); out(ENVIRON["LINE"]) } }' "$f" > "$tmp" && mv "$tmp" "$f"
}

# --- parking ---------------------------------------------------------------
# A gate that no machine check can pass parks the spec: nobody is asked and
# nothing is guessed. The spec keeps its status, gets a "parked" frontmatter
# line and a changelog line, shows under "Waiting for you" on the board, and
# "next" skips it until a person settles the question and runs unpark.

cmd_park() {
  [ $# -ge 3 ] || { echo "usage: jsdd park <ID> <gate> <reason>" >&2; exit 1; }
  local id dir gate reason
  id=$(norm_id "$1"); gate=$2; shift 2; reason="$*"
  [ -n "$(gate_row "$gate")" ] || { echo "unknown gate '$gate' (gates: jsdd mode --explain)" >&2; exit 1; }
  dir=$(spec_dir "$id")
  resolve_mode
  fm_set "$dir/spec.md" parked "$gate: $reason"
  changelog_add "$dir/spec.md" "Parked at gate $gate: $reason$([ "$MODE" = manual ] || echo " (auto: $MODE)")"
  echo "parked $id at $gate: $reason"
  echo "it waits for a person; once settled: jsdd unpark $id"
}

cmd_unpark() {
  [ $# -eq 1 ] || { echo "usage: jsdd unpark <ID>" >&2; exit 1; }
  local id dir
  id=$(norm_id "$1"); dir=$(spec_dir "$id")
  [ -n "$(fm "$dir/spec.md" parked)" ] || { echo "$id is not parked"; return; }
  fm_set "$dir/spec.md" parked
  changelog_add "$dir/spec.md" "Unparked."
  echo "unparked $id"
}

# --- autopilot runs --------------------------------------------------------
# /jsdd:auto <ID> takes one authored spec to a pull request in autopilot mode.
# "run start" marks the run, in the claims folder as run-<ID>, owned by this
# session; the Stop hook asks "run stop-check" whether the session may stop:
# not while its run has work left, budget left, and is making progress.

# A run marker belongs to one session on this machine, so it always lives in
# the local claims folder, also in remote-claims mode (bash's dynamic scope
# makes the claim helpers called from here see these locals).

# my_runs: the spec IDs of the runs this session holds (not its loop).
my_runs() {
  local c CLAIMS="$LOCAL_CLAIMS"
  for c in "$CLAIMS"/run-*/; do
    [ -d "$c" ] || continue
    c=${c%/}
    [ "$(basename "$c")" != run-loop ] || continue
    if [ "$(sed -n 's/^owner=//p' "$c/owner" 2>/dev/null | head -1)" = "$ME" ]; then basename "$c" | cut -c5-; fi
  done
  return 0
}

# my_loop: succeeds when this session holds the autonomous loop.
my_loop() { local CLAIMS="$LOCAL_CLAIMS"; [ -d "$CLAIMS/run-loop" ] && mine run-loop; }

# progress_mark: changes whenever the run commits, edits, or ticks anything.
progress_mark() {
  (cd "$ROOT" && { git rev-parse HEAD 2>/dev/null; git status --porcelain 2>/dev/null; git diff HEAD 2>/dev/null; } | cksum)
}

# run_hours_left <ID|loop>: whole hours left in the wall-time budget (0 or less:
# spent). A spec run inside this session's loop shares the loop's clock.
run_hours_left() {
  local since now r="run-$1"
  local CLAIMS="$LOCAL_CLAIMS"
  ! my_loop || r=run-loop
  now=$(date +%s); since=$(claim_get "$r" since)
  echo $(( $(budget_value wall_time_hours) - ( now - ${since:-$now} ) / 3600 ))
}

# loop_taken: the spec IDs this session's loop has taken, one per line.
loop_taken() { local CLAIMS="$LOCAL_CLAIMS"; sed -n 's/^taken=//p' "$CLAIMS/run-loop/owner" 2>/dev/null; }

# loop_left: why the loop cannot take another spec (nothing when it can).
loop_left() {
  local n
  n=$(loop_taken | grep -c . || true)
  if [ "$(run_hours_left loop)" -le 0 ]; then echo "the wall-time budget is spent ($(budget_value wall_time_hours)h)"
  elif [ "$n" -ge "$(budget_value specs_per_run)" ]; then echo "it took $n of $(budget_value specs_per_run) specs (specs_per_run)"
  elif [ -z "$(loop_pick)" ]; then echo "the queue is empty: jsdd auto dry-run says why each spec is left out"
  fi
}

# loop_pick: the next spec the loop may take: first in the queue, not taken yet.
loop_pick() {
  local id taken
  taken=" $(loop_taken | tr '\n' ' ') "
  for id in $(queue_rows | awk -F '\t' '$4 == "take" { print $1 }'); do
    case $taken in *" $id "*) continue ;; esac
    echo "$id"; return
  done
}

cmd_run() {
  local sub=${1:-} id dir r again=0 st parked left CLAIMS="$LOCAL_CLAIMS" CLAIMS_MODE=local
  case $sub in
    start)
      [ $# -eq 2 ] || { echo "usage: jsdd run start <ID> | --loop" >&2; exit 1; }
      resolve_mode
      if [ "$2" = --loop ]; then
        if [ "$MODE" != autonomous ]; then
          echo "an autonomous loop needs autonomous mode; the mode is $MODE${MODE_WARN:+ ($MODE_WARN)}." >&2
          echo "Allow it in $MODES_REL (modes: [manual, autonomous]) and set SDD_MODE=autonomous." >&2
          exit 1
        fi
        r=run-loop
        if [ -d "$CLAIMS/$r" ]; then
          if mine "$r"; then echo "loop already started by you ($(run_hours_left loop)h left)"; return; fi
          echo "an autonomous loop is held $(claim_desc "$r"); one loop per clone, specs claimed by other runs are skipped" >&2; exit 1
        fi
        claim_take "$r" || { echo "an autonomous loop is held $(claim_desc "$r")" >&2; exit 1; }
        printf 'branch=%s\n' "$(cd "$ROOT" && git rev-parse --abbrev-ref HEAD 2>/dev/null || echo -)" >> "$CLAIMS/$r/owner"
        echo "loop started: preset $(autonomous_preset), up to $(budget_value specs_per_run) specs in $(budget_value wall_time_hours)h, $(budget_value attempts_per_task) attempts per task"
        echo "take the first spec with: jsdd run next"
        return
      fi
      id=$(norm_id "$2"); dir=$(spec_dir "$id"); r="run-$id"
      case $MODE in
        autopilot|autonomous) ;;
        *)
          echo "a run needs autopilot or autonomous mode; the mode is $MODE${MODE_WARN:+ ($MODE_WARN)}." >&2
          echo "Allow one in $MODES_REL (modes: [manual, autopilot]) and set SDD_MODE=autopilot." >&2
          exit 1 ;;
      esac
      parked=$(fm "$dir/spec.md" parked)
      [ -z "$parked" ] || { echo "$id is parked: $parked. Settle it, then: jsdd unpark $id" >&2; exit 1; }
      if [ -d "$CLAIMS/$r" ]; then
        if mine "$r"; then echo "run $id already started by you ($(run_hours_left "$id")h left)"; return; fi
        echo "run $id is held $(claim_desc "$r")" >&2; exit 1
      fi
      claim_take "$r" || { echo "run $id is held $(claim_desc "$r")" >&2; exit 1; }
      printf 'branch=%s\n' "$(cd "$ROOT" && git rev-parse --abbrev-ref HEAD 2>/dev/null || echo -)" >> "$CLAIMS/$r/owner"
      echo "run $id started: $(run_hours_left "$id")h, $(budget_value attempts_per_task) attempts per task" ;;
    next)
      # The loop's next spec: prints its ID and starts its run, or says why there is none.
      resolve_mode
      my_loop || { echo "no autonomous loop in this session: jsdd run start --loop" >&2; exit 1; }
      id=$(my_runs | head -1)
      [ -z "$id" ] || { echo "the run on $id is still open: finish it (pull request, run report), then: jsdd run end $id" >&2; exit 1; }
      left=$(loop_left)
      [ -z "$left" ] || { echo "the loop takes no more specs: $left. Write the loop report and run: jsdd run end --loop" >&2; exit 1; }
      id=$(loop_pick)
      printf 'taken=%s\n' "$id" >> "$CLAIMS/run-loop/owner"
      "$0" run start "$id" >&2
      echo "$id" ;;
    end)
      [ $# -ge 2 ] || { echo "usage: jsdd run end <ID> | --loop [--force]" >&2; exit 1; }
      if [ "$2" = --loop ]; then r=run-loop; id=loop; else id=$(norm_id "$2"); r="run-$id"; fi
      [ -d "$CLAIMS/$r" ] || { echo "no run on $id"; return; }
      if [ "${3:-}" != --force ] && ! mine "$r"; then
        echo "run $id is held $(claim_desc "$r"); use --force if that session is gone" >&2; exit 1
      fi
      if [ "$r" = run-loop ]; then
        echo "loop ended after $(loop_taken | grep -c . || true) specs: $(loop_taken | paste -sd ' ' -)"
        rm -rf "${CLAIMS:?}/$r"
      else
        rm -rf "${CLAIMS:?}/$r"; echo "run $id ended"
      fi ;;
    status)
      [ $# -eq 2 ] || { echo "usage: jsdd run status <ID> | --loop" >&2; exit 1; }
      resolve_mode
      if [ "$2" = --loop ]; then
        my_loop || { echo "no autonomous loop in this session" >&2; exit 1; }
        echo "loop $(claim_desc run-loop): took $(loop_taken | grep -c . || true) of $(budget_value specs_per_run) specs ($(loop_taken | paste -sd ' ' -)); $(run_hours_left loop)h left of $(budget_value wall_time_hours)h"
        left=$(loop_left)
        if [ -n "$left" ]; then echo "takes no more specs: $left"; else echo "next: $(loop_pick)"; fi
        return
      fi
      id=$(norm_id "$2"); dir=$(spec_dir "$id"); r="run-$id"
      [ -d "$CLAIMS/$r" ] || { echo "no run on $id" >&2; exit 1; }
      st=$(fm "$dir/spec.md" status); parked=$(fm "$dir/spec.md" parked)
      echo "run $id $(claim_desc "$r"), on branch $(claim_get "$r" branch); spec $st${parked:+, parked at $parked}"
      if [ "$(run_hours_left "$id")" -le 0 ]; then
        echo "wall-time budget spent ($(budget_value wall_time_hours)h): stop, write the run report, and end the run" >&2; exit 1
      fi
      echo "$(run_hours_left "$id")h left of $(budget_value wall_time_hours)h; $(budget_value attempts_per_task) attempts per task" ;;
    active) my_runs; if my_loop; then echo loop; fi ;;
    stop-check)
      # Prints "block: <reason>" while this session's run must go on, else
      # "allow: <note>" or nothing. --again: the session is already continuing
      # because of an earlier block (the Stop hook's stop_hook_active).
      [ "${2:-}" != --again ] || again=1
      resolve_mode
      for id in $(my_runs); do
        r="run-$id"; dir=$(spec_dir "$id" 2>/dev/null) || continue
        if [ $again = 1 ] && [ "$(cat "$CLAIMS/$r/mark" 2>/dev/null)" = "$(progress_mark)" ]; then
          echo "allow: the run on $id made no progress since it was told to go on; it stops here. Resume with /jsdd:auto $id, or end it with: jsdd run end $id$(! my_loop || echo " and jsdd run end --loop")"; continue
        fi
        progress_mark > "$CLAIMS/$r/mark"
        parked=$(fm "$dir/spec.md" parked)
        if [ -n "$parked" ]; then
          echo "block: The run on $id parked at $parked. Finish the /jsdd:auto run on $id without asking anyone: the run report, the draft pull request, then: jsdd run end $id"
        elif [ "$(run_hours_left "$id")" -le 0 ]; then
          echo "block: The run on $id spent its wall-time budget. Stop building and finish the /jsdd:auto run on $id: the run report, a draft pull request, then: jsdd run end $id"
        else
          echo "block: The run on $id is not finished (spec $(fm "$dir/spec.md" status)). Keep going with the /jsdd:auto steps for $id without asking anyone. If a gate cannot pass, park it: jsdd park $id <gate> \"<reason>\". When the run is done or parked, write the run report, open the pull request, and run: jsdd run end $id"
        fi
        return 0
      done
      if my_loop && [ -z "$(my_runs)" ]; then
        if [ $again = 1 ] && [ "$(cat "$CLAIMS/run-loop/mark" 2>/dev/null)" = "$(progress_mark)" ]; then
          echo "allow: the autonomous loop made no progress since it was told to go on; it stops here. End it with: jsdd run end --loop"; return 0
        fi
        progress_mark > "$CLAIMS/run-loop/mark"
        left=$(loop_left)
        if [ -z "$left" ]; then
          echo "block: The autonomous loop has work and budget left. Take the next spec with: jsdd run next, and follow the /jsdd:auto steps for it without asking anyone."
        else
          echo "block: The autonomous loop takes no more specs: $left. Write the loop report (/jsdd:auto, step 6), then run: jsdd run end --loop"
        fi
      fi ;;
    *) echo "usage: jsdd run <start|next|end|status|active|stop-check> [ID | --loop]" >&2; exit 1 ;;
  esac
}

# --- autonomous queue, dry run, doctor -----------------------------------
# The autonomous loop takes specs from the queue: what jsdd next would offer,
# narrowed to the charter's scope in the autonomous section of specs/jsdd.yml,
# minus what only a person can move (blocked, parked, a spec change from verify)
# and what another session holds.

# in_list <item> <[a, b]>: the item is in the inline list.
in_list() { list_items "$2" 2>/dev/null | grep -qx "$1"; }

# queue_rows: one tab-separated line per live spec, in the order a loop takes them:
# id, type, status, take|skip, why (for a skip) or the next step (for a take).
queue_rows() {
  local phases types groups r id type st phase deps open tnote parked dir refs ref g why num
  phases=$(config_get autonomous phases); types=$(scope_value types); groups=$(config_get autonomous exclude_groups)
  records | sort | awk -F '\t' '
    { st[$1] = $3; line[NR] = $0; id[NR] = $1 }
    END {
      rank["in-progress"] = 1; rank["planned"] = 2; rank["approved"] = 3; rank["draft"] = 4; rank["blocked"] = 5
      for (r = 1; r <= 5; r++) for (i = 1; i <= NR; i++) {
        if (rank[st[id[i]]] != r) continue
        split(line[i], f, "\t"); waiting = ""
        if (f[5] != "-") { m = split(f[5], d, ","); for (j = 1; j <= m; j++) if (st[d[j]] != "done") waiting = waiting " " d[j] }
        print line[i] "\t" (waiting == "" ? "-" : substr(waiting, 2))
      }
    }' | while IFS="$(printf '\t')" read -r id type st phase deps _ _ open _ dir _ tnote parked waiting; do
    num=${dir%%-*}; why=""
    refs=$(fm "$SPECS_DIR/$dir/spec.md" refs | tr -d "[]\"'" | tr ',' ' ')
    if [ "$st" = blocked ]; then why="blocked: a person resumes it (/jsdd:plan $id)"
    elif [ "$parked" != - ]; then why="parked at $parked"
    elif [ "$tnote" = "verify spec change" ]; then why="a spec change from verify waits for a person (/jsdd:specify $id)"
    elif ! in_list "$type" "$types"; then why="type $type is not in autonomous.types $types"
    elif [ -n "$phases" ] && ! in_list "$phase" "$phases"; then why="phase $phase is not in autonomous.phases $phases"
    elif [ "$waiting" != - ]; then why="waiting on $waiting"
    elif [ -d "$CLAIMS/$num" ] && ! mine "$num"; then why="claimed $(claim_desc "$num")"
    elif [ -d "$LOCAL_CLAIMS/run-$id" ] && ! CLAIMS="$LOCAL_CLAIMS" mine "run-$id"; then why="another session runs it"
    elif [ "$type" = baseline ] && [ "$st" = draft ] && [ "$open" -gt 0 ]; then why="$open open questions for the owner in a baseline"
    fi
    if [ -z "$why" ] && [ -n "$groups" ]; then
      for ref in $refs; do
        for g in $(list_items "$groups"); do
          case $ref in "$g"|"$g"-*) why="refs $ref, in autonomous.exclude_groups"; break 2 ;; esac
        done
      done
    fi
    if [ -n "$why" ]; then printf '%s\t%s\t%s\tskip\t%s\n' "$id" "$type" "$st" "$why"; continue; fi
    case $type in
      spike) why="spike: research what the docs and code can answer" ;;
      baseline) why=$([ "$st" = draft ] && echo "baseline: survey and confirm rows" || echo "baseline: verify") ;;
      *) case $st in
           draft) why="feature: review spec, plan, implement, verify" ;;
           approved) why="feature: plan, implement, verify" ;;
           *) why="feature: implement, verify" ;;
         esac ;;
    esac
    printf '%s\t%s\t%s\ttake\t%s\n' "$id" "$type" "$st" "$why"
  done
}

# would_park <ID> <type> <status>: the gates a run on the spec would park at,
# from what is on disk now. One line each; nothing when none is known.
would_park() {
  local dir open manual
  dir=$(spec_dir "$1")
  open=$(count '\[NEEDS CLARIFICATION' "$dir/spec.md")
  if [ "$open" -gt 0 ]; then
    if [ "$(gate_policy spec.clarify autonomous)" = park ] || [ "$(scope_value product)" = park ]; then echo "would park at spec.clarify: $open open questions"
    else echo "sdd-product answers $open open questions as far as product: $(scope_value product) allows; the rest park at spec.clarify"; fi
  fi
  # shellcheck disable=SC2046  # tasks.md is an optional extra argument
  manual=$(uncomment "$dir/spec.md" $( [ -f "$dir/tasks.md" ] && echo "$dir/tasks.md" ) | grep -Eo '\*\*(T[0-9]+|AC-[0-9]+)\*\*.*check: manual' | grep -Eo '^\*\*(T[0-9]+|AC-[0-9]+)' | tr -d '*' | paste -sd ' ' - || true)
  [ -z "$manual" ] || [ "$(gate_policy task.manual_check autonomous)" != park ] || echo "would park at task.manual_check: $manual needs a person"
  if [ "$2" = spike ] && [ "$(gate_policy spike.question autonomous)" = park ]; then echo "parks at spike.question if a question needs the owner"; fi
  if [ "$2" = feature ] && [ "$3" = draft ] && [ "$(gate_policy spec.approve autonomous)" = park ]; then echo "would park at spec.approve"; fi
  return 0
}

cmd_auto() {
  local sub=${1:-} rows id type st verdict why n=0 max fails=0 warns=0 f mode_ok perm=""
  case $sub in
    queue)
      resolve_mode; load_config
      queue_rows | awk -F '\t' '$4 == "take" { printf "%s\t%s\t%s\t%s\n", $1, $2, $3, $5 }' ;;
    dry-run)
      resolve_mode
      [ -z "$CONFIG_ERRORS" ] || { printf '%s\n' "$CONFIG_ERRORS"; echo "fix $MODES_REL first: jsdd mode --check" >&2; exit 1; }
      mode_allowed autonomous || echo "note: $MODES_REL does not list autonomous under modes yet, so no run can start"
      max=$(MODE=autonomous budget_value specs_per_run)
      echo "autonomous, preset $(autonomous_preset), product $(scope_value product): up to $max specs in $(MODE=autonomous budget_value wall_time_hours)h; types $(scope_value types), phases $(scope_value phases), excluding $(scope_value exclude_groups)"
      echo "merge: $( [ "$(gate_policy merge autonomous)" = auto ] && echo "a converged spec with green CI is merged" || echo "each spec ends at a pull request for you to merge")"
      echo
      rows=$(queue_rows)
      echo "A loop would take, in order:"
      while IFS="$(printf '\t')" read -r id type st verdict why; do
        [ "$verdict" = take ] || continue
        n=$((n + 1))
        printf '  %-4s %-8s %-11s %s%s\n' "$id" "$type" "$st" "$why" "$([ $n -le "$max" ] || echo "   (after specs_per_run: next loop)")"
        would_park "$id" "$type" "$st" | sed 's/^/         /'
      done <<EOF
$rows
EOF
      [ $n -gt 0 ] || echo "  (nothing)"
      if printf '%s\n' "$rows" | grep -q "$(printf '\tskip\t')"; then
        echo "Left out:"
        printf '%s\n' "$rows" | awk -F '\t' '$4 == "skip" { printf "  %-4s %s\n", $1, $5 }'
      fi ;;
    doctor)
      resolve_mode
      d_ok() { echo "ok    $*"; }
      d_bad() { echo "FIX   $1"; [ -z "${2:-}" ] || printf '      %s\n' "$2"; fails=$((fails + 1)); }
      d_warn() { echo "warn  $1"; [ -z "${2:-}" ] || printf '      %s\n' "$2"; warns=$((warns + 1)); }
      if [ -n "$CONFIG_ERRORS" ]; then d_bad "$MODES_REL is invalid" "$(printf '%s' "$CONFIG_ERRORS" | head -3 | paste -sd ';' -) (all of them: jsdd mode --check)"
      elif [ ! -f "$MODES_FILE" ]; then d_bad "no $MODES_REL" "run /jsdd:auto setup, or write: version: 1 / modes: [manual, autonomous] / autonomous: / preset: cautious"
      else d_ok "$MODES_REL is valid"
      fi
      mode_ok=1
      case $MODE in
        autonomous|autopilot) d_ok "mode: $MODE ($MODE_SOURCE)" ;;
        *) mode_ok=""
           d_bad "mode is $MODE${MODE_WARN:+: $MODE_WARN}" "set SDD_MODE=autonomous in your shell, or under \"env\" in .claude/settings.local.json, then start a new session" ;;
      esac
      if [ -z "$GIT_COMMON" ]; then d_bad "not a git repository" "git init, and commit the project"
      else
        if [ -n "$(cd "$ROOT" && git status --porcelain 2>/dev/null | grep -v '^?? specs/STATUS.md$' || true)" ]; then
          d_bad "the work tree has uncommitted changes" "commit or stash them: a run commits each task and must not sweep up your work"
        else d_ok "the work tree is clean"; fi
        if [ "$(cd "$ROOT" && git rev-parse --abbrev-ref HEAD 2>/dev/null)" = "$MAIN_BRANCH" ]; then
          d_ok "on $MAIN_BRANCH: each run creates its own branch (autonomous/<ID>-<slug>)"
        fi
      fi
      if [ -n "$mode_ok" ] && [ "$(gate_policy pr.open "$MODE")" != park ]; then
        if (cd "$ROOT" && git remote get-url origin >/dev/null 2>&1); then d_ok "remote origin is set"
        else d_warn "no remote named origin, so runs end with a local branch, not a pull request" "git remote add origin <url>"; fi
        if ! command -v gh >/dev/null 2>&1; then d_warn "gh is not installed: no pull requests" "install the GitHub CLI (https://cli.github.com), then: gh auth login"
        elif ! gh auth status >/dev/null 2>&1; then d_warn "gh is not signed in, so runs end with a local branch" "gh auth login"
        else d_ok "gh is signed in"; fi
      fi
      [ "$MODE" != autonomous ] || [ "$(gate_policy merge autonomous)" != auto ] \
        || d_warn "preset $(autonomous_preset) merges converged specs once CI is green" "make sure the main branch requires CI checks; without any check, a run never merges"
      for f in "$ROOT/.claude/settings.local.json" "$ROOT/.claude/settings.json" "$HOME/.claude/settings.json"; do
        [ -f "$f" ] || continue
        perm=$(tr -d '\r\n' <"$f" | grep -Eo '"defaultMode"[[:space:]]*:[[:space:]]*"[A-Za-z]+"' | head -1 | sed 's/.*"\([A-Za-z]*\)"$/\1/') || true
        [ -z "$perm" ] || { perm="$perm (from ${f#"$ROOT"/})"; break; }
      done
      case $perm in
        bypassPermissions*|auto\ *) d_ok "permission mode: $perm, so a run is not stopped by prompts" ;;
        acceptEdits*) d_warn "permission mode: $perm: edits pass, but commands still prompt and stall the run" \
          "add allow rules to .claude/settings.local.json: \"permissions\": {\"allow\": [\"Bash(jsdd *)\", \"Bash(git *)\", \"Bash(gh *)\", \"Bash(<your test command> *)\"]}" ;;
        *) d_warn "permission mode: ${perm:-default}: every edit and command prompts, so an unattended run stalls at the first one" \
          "start the session with: claude --permission-mode acceptEdits, and allow jsdd, git, gh, and your test command in .claude/settings.local.json (\"permissions\": {\"allow\": [\"Bash(jsdd *)\", \"Bash(git *)\", \"Bash(gh *)\"]}); bypassPermissions only in a container or VM" ;;
      esac
      echo
      if [ $fails -gt 0 ]; then echo "$fails to fix$([ $warns -eq 0 ] || echo ", $warns warnings")"; exit 1; fi
      echo "ready$([ $warns -eq 0 ] || echo ", $warns warnings")" ;;
    *) echo "usage: jsdd auto <queue | dry-run | doctor>" >&2; exit 1 ;;
  esac
}

# --- frozen checks ---------------------------------------------------------
# With nobody watching, an agent could make a failing task pass by weakening its
# check. "freeze" records each task's check in checks.lock in the spec folder
# when its plan is approved; "done" then refuses a task whose check changed, or
# a task the lock does not know, until freeze records it again. A changed check
# needs --accept and a Deviation row in plan.md that names the task.

# task_checks <tasks.md>: one line per task: ID, TAB, its check command or "manual".
task_checks() {
  local t row cmd tab
  tab=$(printf '\t')
  for t in $(task_rows 000 "$1" | awk '{ print $1 }'); do
    row=$(task_line "$1" "$t"); cmd=$(check_of "${row#*"$tab"}")
    printf '%s\t%s\n' "$t" "${cmd:-manual}"
  done
}

# lock_get <checks.lock> <Tn>: the frozen check, or nothing.
lock_get() {
  [ -f "$1" ] || return 0
  awk -v t="$2" '{ sub(/\r$/, "") } index($0, t "\t") == 1 { print substr($0, length(t) + 2); exit }' "$1"
}

cmd_freeze() {
  [ $# -ge 1 ] || { echo "usage: jsdd freeze <ID> [--accept <Tn>...]" >&2; exit 1; }
  local id dir lock t cmd old accept=" " changed="" checks devs tab total added=0
  id=$(norm_id "$1"); shift
  if [ "${1:-}" = --accept ]; then shift; for t in "$@"; do accept="$accept$(norm_task "$t") "; done; fi
  dir=$(spec_dir "$id"); lock="$dir/checks.lock"; tab=$(printf '\t')
  [ -f "$dir/tasks.md" ] || { echo "$id has no tasks.md" >&2; exit 1; }
  checks=$(task_checks "$dir/tasks.md")
  devs=$(section "$dir/plan.md" Deviations)
  while IFS="$tab" read -r t cmd; do
    [ -n "$t" ] || continue
    old=$(lock_get "$lock" "$t")
    if [ -z "$old" ]; then added=$((added + 1)); continue; fi
    [ "$old" != "$cmd" ] || continue
    case $accept in
      *" $t "*)
        printf '%s\n' "$devs" | grep -Eq "(^|[^0-9A-Za-z])$t([^0-9]|\$)" \
          || { echo "$t: --accept needs a row in plan.md's Deviations that names $t" >&2; exit 1; } ;;
      *) changed="$changed  $t: frozen \`$old\`, now \`$cmd\`
" ;;
    esac
  done <<CHECKS
$checks
CHECKS
  if [ -n "$changed" ]; then
    printf 'checks changed since they were frozen:\n%s' "$changed" >&2
    echo "Record a Deviation naming each task, have the reviewer accept it, then: jsdd freeze $id --accept <Tn>..." >&2
    exit 1
  fi
  { echo "# Checks frozen when the plan was approved, by jsdd freeze. jsdd done refuses a task whose check differs."
    printf '%s\n' "$checks"; } > "$lock"
  total=$(printf '%s\n' "$checks" | grep -c . || true)
  echo "froze the checks of $id: $total tasks, $added new, in ${lock#"$ROOT"/}"
}

# --- pull request body -----------------------------------------------------

# section <file> <heading>: the lines under "## <heading>" up to the next "## ", outside comments, trimmed.
section() {
  [ -f "$1" ] || return 0
  uncomment "$1" | H="## $2" awk '
    /^## / { on = ($0 == ENVIRON["H"]); next }
    on { if ($0 == "") { nb++; next } if (shown) for (i = 0; i < nb; i++) print ""; nb = 0; print; shown = 1 }'
}

cmd_pr() {
  [ $# -ge 1 ] || { echo "usage: jsdd pr <ID> [--title]" >&2; exit 1; }
  local id dir spec rel out refs parked
  id=$(norm_id "$1"); dir=$(spec_dir "$id"); spec="$dir/spec.md"; rel=${dir#"$ROOT"/}
  if [ "${2:-}" = --title ]; then echo "[$id] $(fm "$spec" title)"; return; fi
  refs=$(fm "$spec" refs | tr -d "[]\"'"); parked=$(fm "$spec" parked)
  printf 'Spec [%s](%s/spec.md) · %s · status %s%s\n' "$id" "$rel" "$(fm "$spec" type)" "$(fm "$spec" status)" "${refs:+ · refs $refs}"
  [ -z "$parked" ] || printf '\n> **Parked at %s.** A person must settle this before merging.\n' "$parked"
  out=$(section "$spec" Problem); [ -z "$out" ] || printf '\n## Why\n\n%s\n' "$out"
  out=$(section "$spec" Requirements); [ -z "$out" ] || printf '\n## Requirements\n\n%s\n' "$out"
  out=$(section "$dir/tasks.md" Evidence); [ -z "$out" ] || printf '\n## Acceptance criteria and evidence\n\n%s\n' "$out"
  out=$(section "$dir/tasks.md" Tasks | grep -E '^[[:space:]]*- \[[ xX]\]' || true)
  [ -z "$out" ] || printf '\n## Tasks\n\n%s\n' "$out"
  out=$(section "$dir/plan.md" Deviations); [ -z "$out" ] || printf '\n## Deviations from the plan\n\n%s\n' "$out"
  out=$(section "$dir/run-report.md" 'Product decisions'); [ -z "$out" ] || printf '\n## Product decisions to review (weakest basis first)\n\n%s\n' "$out"
  out=$(section "$dir/run-report.md" 'Decisions made without a person'); [ -z "$out" ] || printf '\n## Decisions made without a person\n\n%s\n' "$out"
  [ ! -f "$dir/run-report.md" ] || printf '\nRun report: [%s/run-report.md](%s/run-report.md)\n' "$rel" "$rel"
  return 0
}

cmd_status() {
  local out claims
  resolve_mode
  mode_banner
  out=$(board)
  printf '%s\n\nNext up:\n%s\n' "$out" "$(next_up)"
  claims=$(list_claims)
  if [ -n "$claims" ]; then printf '\nClaims:\n'; claims_banner; printf '%s\n' "$claims"; fi
  local_leftovers
  if [ -f "$REQUIREMENTS" ]; then
    out="$out

Requirement coverage (\`jsdd coverage\`):

\`\`\`
$(coverage_rows | coverage_summary)
\`\`\`"
    printf '\nRequirement coverage:\n%s\n' "$(coverage_rows | coverage_summary)"
  fi
  if [ "${1:-}" = "--write" ]; then
    {
      echo "# Status"
      echo
      echo "Generated by \`jsdd status --write\`. Do not edit by hand."
      echo
      printf '%s\n' "$out"
    } > "$SPECS_DIR/STATUS.md"
    echo; echo "Wrote specs/STATUS.md"
  fi
}

# --- init ------------------------------------------------------------------
# Starters are the project's once copied, so init never overwrites them;
# specs/README.md describes the kit, so it is refreshed. --migrate removes what
# install.sh used to copy into the project, which the plugin replaces.

OLD_KIT=".claude/skills/sdd-implement .claude/skills/sdd-plan .claude/skills/sdd-specify
.claude/skills/sdd-spike .claude/skills/sdd-status .claude/skills/sdd-verify
.claude/agents/sdd-reviewer.md .claude/agents/spike-researcher.md
.claude/hooks/session-start.sh .claude/hooks/pre-commit-message.sh
.claude/hooks/post-edit-status.sh .claude/hooks/stop-claims.sh specs/_kit"
OLD_HOOKS='\.claude/hooks/(session-start|pre-commit-message|post-edit-status|stop-claims)\.sh'
ALLOW='Bash(jsdd *)'

# kit_marker <starter>: a line every kit-format copy of the file has. An
# existing file without it is the project's own document under the same name.
kit_marker() {
  case $1 in
    docs/intent.md) echo '^## The product in one sentence' ;;
    docs/requirements.md) echo '^\| *N?FR-[A-Z0-9]+-[0-9]+[a-z]? *\|' ;;
    docs/decisions.md) echo '^## Decided' ;;
    PLAN.md) echo '^## Phase [0-9]' ;;
    BACKLOG.md) echo '^## Spikes' ;;
    specs/constitution.md) echo '^## Engineering articles' ;;
  esac
}

# foreign_starters: starter paths the project already has in another format.
foreign_starters() {
  local f re
  for f in docs/intent.md docs/requirements.md docs/decisions.md PLAN.md BACKLOG.md specs/constitution.md; do
    [ -f "$ROOT/$f" ] || continue
    re=$(kit_marker "$f")
    grep -Eq "$re" "$ROOT/$f" || printf '%s\n' "$f"
  done
}

# source_for <path>: the starters a project document may cover, judged by its
# name only. /jsdd:init reads each one to decide what it really covers.
source_for() {
  local n
  n=$(basename "$1" | tr '[:upper:]' '[:lower:]')
  case $n in
    *prd*|*product?requirements*) echo "docs/intent.md docs/requirements.md" ;;
    *requirement*|*features*) echo docs/requirements.md ;;
    *intent*|*vision*|*product*|*overview*|*about*|*mission*) echo docs/intent.md ;;
    adr|adrs|decisions|architecture?decisions|*decision*.md|adr?*.md) echo docs/decisions.md ;;
  esac
}

# possible_sources: project documents outside the kit's paths that may already
# hold a starter's content, as "<path>\t<starters>", for the starters that are
# missing or still the kit's blank copy. Looks at the root and docs/ (or doc/),
# one level of subfolders, and skips docs/legacy/, which init has already used.
possible_sources() {
  local p s f open
  (cd "$ROOT" && find . -maxdepth 1 -type f -iname '*.md' 2>/dev/null
   find . -mindepth 1 -maxdepth 1 -type d \( -iname adr -o -iname adrs -o -iname decisions \)
   for d in docs doc; do
     [ -d "$d" ] || continue
     find "$d" -maxdepth 1 -type f -iname '*.md'
     find "$d" -mindepth 1 -maxdepth 1 -type d ! -name legacy
     find "$d" -mindepth 2 -maxdepth 2 -type f -iname '*.md' ! -path "$d/legacy/*"
   done) | sed 's|^\./||' | sort | while IFS= read -r p; do
    case $p in
      README*|readme*|CHANGELOG*|CONTRIBUTING*|LICENSE*|SECURITY*|CODE_OF_CONDUCT*|CLAUDE.md|AGENTS.md) continue ;;
      docs/intent.md|docs/requirements.md|docs/decisions.md|PLAN.md|BACKLOG.md) continue ;;
    esac
    # A file inside a decisions folder is covered by the folder.
    case $(basename "$(dirname "$p")" | tr '[:upper:]' '[:lower:]') in
      adr|adrs|decisions|architecture?decisions) continue ;;
    esac
    s=$(source_for "$p")
    [ -d "$ROOT/$p" ] && { case $s in docs/decisions.md) p="$p/" ;; *) continue ;; esac; }
    open=""
    for f in $s; do
      if [ ! -e "$ROOT/$f" ] || cmp -s "$STARTERS/$f" "$ROOT/$f"; then open="$open $f"; fi
    done
    [ -z "$open" ] || printf '%s\t%s\n' "$p" "${open# }"
  done
}

# test_commands: test commands the project's build files suggest, one per line.
test_commands() {
  local s
  if [ -f "$ROOT/package.json" ]; then
    s=$(jq -r '.scripts.test // empty' "$ROOT/package.json" 2>/dev/null || true)
    case $s in
      ""|*"no test specified"*) ;;
      *) if [ -f "$ROOT/pnpm-lock.yaml" ]; then echo "pnpm test"
         elif [ -f "$ROOT/yarn.lock" ]; then echo "yarn test"
         elif [ -f "$ROOT/bun.lockb" ] || [ -f "$ROOT/bun.lock" ]; then echo "bun run test"
         else echo "npm test"; fi ;;
    esac
  fi
  for s in Makefile makefile GNUmakefile; do
    [ -f "$ROOT/$s" ] && grep -Eq '^test:' "$ROOT/$s" && { echo "make test"; break; }
  done
  if [ -f "$ROOT/pytest.ini" ] || grep -qs pytest "$ROOT/pyproject.toml" "$ROOT/setup.cfg" "$ROOT/tox.ini"; then echo "pytest"; fi
  [ -f "$ROOT/go.mod" ] && echo "go test ./..."
  [ -f "$ROOT/Cargo.toml" ] && echo "cargo test"
  [ -f "$ROOT/mix.exs" ] && echo "mix test"
  [ -f "$ROOT/deno.json" ] && echo "deno test"
  [ -f "$ROOT/pom.xml" ] && echo "mvn test"
  if [ -f "$ROOT/build.gradle" ] || [ -f "$ROOT/build.gradle.kts" ]; then
    if [ -f "$ROOT/gradlew" ]; then echo "./gradlew test"; else echo "gradle test"; fi
  fi
  [ -f "$ROOT/Gemfile" ] && [ -d "$ROOT/spec" ] && echo "bundle exec rspec"
  return 0
}

# existing_code: what init reports about a project that already has code, for
# /jsdd:init to decide whether it is brownfield. Prints nothing outside git or
# when only the kit's own paths are tracked.
# old_kit_refs: Markdown files outside specs/ and docs/legacy/ that still point at the
# install.sh kit (specs/_kit/sdd, /sdd-* commands, .claude/skills/sdd-*), one line per
# file with the line numbers. Instructions such as CLAUDE.md would send sessions to
# commands that no longer exist once the old copy is removed.
old_kit_refs() {
  local f lines
  (cd "$ROOT" && { find . -maxdepth 1 -type f -iname '*.md'
     find .claude -maxdepth 1 -type f -iname '*.md' 2>/dev/null
     for d in docs doc; do
       if [ -d "$d" ]; then find "$d" -maxdepth 2 -type f -iname '*.md' ! -path "$d/legacy/*"; fi
     done; } | sed 's|^\./||' | sort) | while IFS= read -r f; do
    lines=$(tr -d '\r' <"$ROOT/$f" | grep -nE 'specs/_kit/sdd|/sdd-(specify|plan|implement|verify|spike|status)|\.claude/skills/sdd-' \
      | cut -d: -f1 | paste -sd, - | sed 's/,/, /g' || true)
    [ -z "$lines" ] || echo "  stale    $f (lines $lines)"
  done
}

existing_code() {
  local files commits tests
  files=$(cd "$ROOT" && git ls-files 2>/dev/null \
    | grep -vE '^(\.claude/|\.github/|specs/|docs/|PLAN\.md$|BACKLOG\.md$|README|LICENSE|CHANGELOG|CONTRIBUTING|\.gitignore$)' \
    | wc -l | tr -d ' ' || true)
  [ "${files:-0}" -gt 0 ] || return 0
  commits=$(cd "$ROOT" && git rev-list --count HEAD 2>/dev/null || echo 0)
  tests=$(test_commands | paste -sd, - | sed 's/,/, /g')
  echo "Existing code:"
  echo "  tracked files outside the kit's paths: $files; commits: $commits"
  echo "  test commands found: ${tests:-none}"
}

cmd_init() {
  local migrate="" dry="" a f old="" foreign sources settings="$ROOT/.claude/settings.json" json new
  for a in "$@"; do
    case $a in
      --migrate) migrate=1 ;;
      --dry-run) dry=1 ;;
      *) echo "unknown option '$a'" >&2; usage >&2; exit 1 ;;
    esac
  done
  run() { [ -n "$dry" ] || "$@"; }

  for f in $OLD_KIT; do [ -e "$ROOT/$f" ] && old="$old $f"; done
  if [ -n "$old" ] && [ -z "$migrate" ]; then
    echo "This project has the kit that install.sh copied in. With the plugin as well," >&2
    echo "every hook would run twice. Run 'jsdd init --migrate' to remove the old copy." >&2
    exit 1
  fi

  foreign=$(foreign_starters | tr '\n' ' ')
  sources=$(possible_sources)
  echo "Starters:"
  (cd "$STARTERS" && find . -type f ! -name .DS_Store | sed 's|^\./||' | sort) | while IFS= read -r f; do
    if [ ! -e "$ROOT/$f" ]; then
      echo "  add      $f"; run mkdir -p "$(dirname "$ROOT/$f")"; run cp "$STARTERS/$f" "$ROOT/$f"
    elif [ "$f" = specs/README.md ] && ! cmp -s "$STARTERS/$f" "$ROOT/$f"; then
      echo "  update   $f"; run cp "$STARTERS/$f" "$ROOT/$f"
    else
      case " $foreign " in *" $f "*) echo "  keep     $f (the project's own file, not in kit format)" ;; esac
    fi
  done
  if [ -n "$foreign" ]; then
    echo "  The kit cannot read the files marked keep. Move each to docs/legacy/ and run init"
    echo "  again to get the kit's version; /jsdd:init then folds the old content into it."
  fi
  if [ -n "$sources" ]; then
    echo "Possible sources (by name only; /jsdd:init reads them to decide):"
    printf '%s\n' "$sources" | while IFS="$(printf '\t')" read -r a f; do
      case $a in PRODUCT_INTENT.md) a="$a (the install.sh kit's intent file)" ;; esac
      echo "  source   $a for $(echo "$f" | sed 's/ / and /')"
    done
  fi

  if [ -n "$old" ]; then
    echo "Old kit (from install.sh):"
    for f in $old; do echo "  remove   $f"; run rm -rf "${ROOT:?}/$f"; done
    for f in skills agents hooks; do run rmdir "$ROOT/.claude/$f" 2>/dev/null || true; done
  fi

  a=$(old_kit_refs)
  if [ -n "$a" ]; then
    echo "Old kit references (point them at /jsdd:* and jsdd; /jsdd:init offers to):"
    printf '%s\n' "$a"
  fi

  # Settings: drop the old kit's hooks and permission, allow jsdd without a prompt.
  json='{}'; [ -f "$settings" ] && json=$(jq . "$settings" | tr -d '\r')
  new=$(printf '%s' "$json" | jq --arg re "$OLD_HOOKS" --arg allow "$ALLOW" '
    if .hooks then
      .hooks |= (with_entries(.value |= (map(.hooks |= map(select((.command // "") | test($re) | not)))
                                         | map(select(.hooks | length > 0))))
                 | with_entries(select(.value | length > 0)))
      | if .hooks == {} then del(.hooks) else . end
    else . end
    | .permissions.allow |= ((. // []) | map(select(. != "Bash(specs/_kit/sdd *)" and . != "Bash(sdd *)"))
                             | if any(.[]; . == $allow) then . else . + [$allow] end)' | tr -d '\r')
  if [ "$new" != "$json" ]; then
    echo "Settings:"
    echo "  update   .claude/settings.json (allow $ALLOW${old:+; remove the old hooks})"
    run mkdir -p "$ROOT/.claude"
    [ -n "$dry" ] || printf '%s\n' "$new" > "$settings"
  fi

  if ! { tr -d '\r' <"$ROOT/.gitignore"; } 2>/dev/null | grep -qxF .claude/settings.local.json; then
    echo "  ignore   .claude/settings.local.json (.gitignore)"
    [ -n "$dry" ] || printf '%s\n' .claude/settings.local.json >> "$ROOT/.gitignore"
  fi

  echo
  a=$(existing_code)
  [ -z "$a" ] || printf '%s\n\n' "$a"
  if [ -n "$dry" ]; then echo "Dry run: nothing changed."; return; fi
  [ -z "$old" ] || echo "The removed files are still in git history. Move any project tweaks (test command, architecture rules) into specs/constitution.md, under Project specifics."
  if grep -q 'FR-AUTH-01 | <one behavior>' "$ROOT/docs/requirements.md" 2>/dev/null; then
    printf '%s\n' "Next steps:" \
      "  1. Fill in docs/intent.md, then the product articles and Project specifics in specs/constitution.md." \
      "  2. List requirements in docs/requirements.md, and phases in PLAN.md tagged with their IDs." \
      "  3. Run /jsdd:status."
  fi
}

case "${1:-}" in
  init|-h|--help|help|"") ;;
  *) [ -d "$SPECS_DIR" ] || { echo "no specs/ folder in $ROOT: run 'jsdd init' first" >&2; exit 1; } ;;
esac

# Remote claims: a write fetches first and stops when the remote is unreachable;
# a read reuses a recent fetch and falls back to the cache.
case "${1:-}" in
  claim|release|done|new) claims_sync write ;;
  claims) if [ "${2:-}" = --prune ]; then claims_sync write; else claims_sync; fi ;;
  status|next) claims_sync ;;
esac

case "${1:-}" in
  init) shift; cmd_init "$@" ;;
  new) shift; cmd_new "$@" ;;
  status) shift; cmd_status "$@" ;;
  next) next_up ;;
  claim) shift; cmd_claim "$@" ;;
  release) shift; cmd_release "$@" ;;
  done) shift; cmd_done "$@" ;;
  claims) shift; cmd_claims "$@" ;;
  coverage) shift; cmd_coverage "$@" ;;
  capabilities) shift; cmd_capabilities "$@" ;;
  mode) shift; cmd_mode "$@" ;;
  gate) shift; cmd_gate "$@" ;;
  budget) shift; cmd_budget "$@" ;;
  park) shift; cmd_park "$@" ;;
  unpark) shift; cmd_unpark "$@" ;;
  run) shift; cmd_run "$@" ;;
  charter) shift; cmd_charter "$@" ;;
  auto) shift; cmd_auto "$@" ;;
  freeze) shift; cmd_freeze "$@" ;;
  pr) shift; cmd_pr "$@" ;;
  -h|--help|help|"") usage ;;
  *) echo "unknown command '$1'" >&2; usage >&2; exit 1 ;;
esac
